+  assert.equal(computeIncrementalFace({ ledger: { head: null, failedFiles: ['f'] }, filesSince: [], fullFace: face }), null)
+  // 增量面 ≥ 全量面 → null（回全子集）
+  assert.equal(computeIncrementalFace({ ledger: { head: 'x', failedFiles: face }, filesSince: face, fullFace: face }), null)
