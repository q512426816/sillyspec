+
+// ── 终态后台化（2026-11-09-terminal-sync-background）────────────────────────
+
+test('终态 + 后台可用（bgImpl spawned）→ pending marker + delegated background，不内联不置 exitCode', async () => {
+  process.env.SILLYHUB_PLATFORM_URL = 'http://127.0.0.1:9'
