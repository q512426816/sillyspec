+function splitSections(text) {
+  const out = []
+  let cur = null
+  for (const line of text.split('\n')) {
+    const m = /^##\s+(.+)$/.exec(line)
+    if (m) {
+      cur = { title: m[1].trim(), body: '' }
+      out.push(cur)
+      continue
+    }
