+  const qp = quickTallyPath(cwd, 'quick-abcd1234')
+  assert.ok(existsSync(qp), 'quick 会话计数文件存在')
+  const nq = norm(qp)
+  assert.ok(
+    nq.includes('/.runtime/quick-sessions/quick-abcd1234/'),
+    'quick 会话路径落 .runtime/quick-sessions/<id>/'
