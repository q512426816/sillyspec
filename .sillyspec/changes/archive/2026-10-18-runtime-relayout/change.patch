+  const before = list(root).join(',')
+  const r2 = migrateRuntimeLayout(root)
+  assert(r2.stateMoved === 0 && r2.tempMoved === 0 && r2.skipped === 0, `重跑零副作用（实际 ${r2.stateMoved}/${r2.tempMoved}/${r2.skipped}）`)
+  assert(list(root).join(',') === before, '重跑后根目录状态不变')
+}
+
+// ─────────────────────────────────────────
+console.log('\n--- 6. FR-01 写入面：真实写入点产物落 state/ 子目录 ---')
+{
+  const root = join(tmpRoot, 'w', '.runtime')
+  const c = '2026-10-18-demo'
+  assert(draftLedgerPath(root, c) === join(root, 'state', `draft-ledger-${c}.json`), 'draftLedgerPath（flow-draft 写入面）落 state/')
+  assert(watcherEventsPath(root, c) === join(root, 'state', `watcher-events-${c}.jsonl`), 'watcherEventsPath（watcher 子进程落盘锚）落 state/')
+  assert(testLedgerPath(root, c) === join(root, 'state', `test-ledger-${c}.json`), 'testLedgerPath 落 state/')
+  assert(stageReviewMarkerPath(root, 'execute', c) === join(root, 'state', `current-stage-review-run-id-execute-${c}`), 'stageReviewMarkerPath 落 state/')
+}
+
+console.log('\n--- 7. FR-02 temp 面：日志/备份产物落 temp/ 且删除后可重建 ---')
+{
+  const root = join(tmpRoot, 't', '.runtime')
+  mkdirSync(root, { recursive: true })
+  assert(bgSyncLogPath(root) === join(root, 'temp', BG_LOG_FILENAME), 'bgSyncLogPath（spec-sync-bg.log）落 temp/')
+  // 迁移把旧日志收进 temp/（复用 migrate 的已知产物面）
+  writeFileSync(join(root, 'spec-sync-bg.log'), 'old-log')
+  writeFileSync(join(root, 'watcher.log'), 'old-wlog')
+  const r = migrateRuntimeLayout(root)
+  assert(r.tempMoved === 2 && existsSync(join(root, 'temp', 'watcher.log')), '旧日志迁移入 temp/')
+  // temp/ 整体删除后：无 reader 依赖 + 写入点模式（mkdir recursive + append）自动重建
+  rmSync(join(root, 'temp'), { recursive: true, force: true })
+  let recreated = false
+  try {
+    mkdirSync(join(root, 'temp'), { recursive: true })
+    writeFileSync(bgSyncLogPath(root), 'line')
+    recreated = existsSync(bgSyncLogPath(root))
+  } catch { recreated = false }
+  assert(recreated, '删除 temp/ 后写入自动重建（无状态语义，功能不依赖 temp 存活）')
+}
+
+console.log('\n--- 8. FR-03 prune：state/ 全家族回收 + 根路径兜底 ---')
+{
+  const root = join(tmpRoot, 'pr', '.runtime')
+  const c = '2026-10-18-arch-me'
+  mkdirSync(join(root, 'state'), { recursive: true })
+  // state/ 全家族在场（抽样覆盖各族形态：json/jsonl/txt/无扩展名 marker）
+  for (const n of ['draft-ledger-ARCH.json', 'watcher-events-ARCH.jsonl', `apply-pathspec-${c}.txt`,
+    `friction-tally-${c}.json`, `current-execute-run-id-${c}`, `current-stage-review-run-id-plan-${c}`,
+    `ceremony-tier-${c}.json`, `test-ledger-${c}.json`]) {
+    mkdirSync(join(root, 'state'), { recursive: true })
+    writeFileSync(join(root, 'state', n.includes('ARCH') ? n.replace('ARCH', c) : n), '{}')
+  }
+  // 根目录旧布局兜底面：混版本迟到文件
+  writeFileSync(join(root, `draft-ledger-${c}.json`), 'late-old')
+  // 他变更文件：不得连坐
+  mkdirSync(join(root, 'state'), { recursive: true })
+  writeFileSync(join(root, 'state', 'draft-ledger-2026-10-18-other.json'), 'OTHER')
+
+  const r = pruneArchivedChangeRuntime(root, c)
+  assert(r.ok && r.removed >= 9, `回收含根路径兜底与他变更隔离（removed=${r.removed}）`)
+  assert(!existsSync(join(root, 'state', `draft-ledger-${c}.json`)) && !existsSync(join(root, `draft-ledger-${c}.json`)), 'state/ 与根目录同名双双回收')
+  assert(!existsSync(join(root, 'state', `current-stage-review-run-id-plan-${c}`)), '无扩展名 marker 回收')
+  assert(existsSync(join(root, 'state', 'draft-ledger-2026-10-18-other.json')), '他变更文件不受影响（精确名，非后缀匹配）')
+  // 幂等：重跑零新增回收
+  const r2 = pruneArchivedChangeRuntime(root, c)
+  assert(r2.removed === 0, `幂等（removed=${r2.removed}）`)
+}
+
+console.log('\n--- 9. FR-04 入口迁移：CLI 调用自动收敛旧布局（spawn 级） ---')
+{
+  const repo = join(tmpRoot, 'repo', 'proj')
+  const rt = join(repo, '.sillyspec', '.runtime')
+  mkdirSync(rt, { recursive: true })
+  mkdirSync(join(rt, 'state'), { recursive: true })
+  writeFileSync(join(rt, 'draft-ledger-2026-01-01-upgrade.json'), 'D')
+  writeFileSync(join(rt, 'ceremony-tier-2026-01-01-upgrade.json'), 'C')
+  writeFileSync(join(rt, 'watcher.log'), 'L')
+  writeFileSync(join(rt, 'repro-junk.mjs'), 'J') // 未知归属：入口迁移也不动
+  const childEnv = { ...process.env, SILLYSPEC_SYNC_BG: '0', SILLYSPEC_WATCHER: '0' } // 禁后台旁路：满载套件下子进程拖时间/残留句柄
+  const r = spawnSync(process.execPath, [join(process.cwd(), 'bin', 'sillyspec.js'), 'status', '--dir', repo], {
+    cwd: repo, // 子进程 cwd 锚临时仓：防 cwd 解析在真实仓/测试目录落 .sillyspec 污染
