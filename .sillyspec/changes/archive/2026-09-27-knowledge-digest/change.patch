+test('④ CLI knowledge digest --json 端到端', () => {
+  const q = fixture({ autoDomain: true, inboxCount: 25 })
+  const bin = join(dirname(fileURLToPath(import.meta.url)), '..', 'bin', 'sillyspec.js')
