+/** 写文件并提交（自动建父目录） */
+function commitFile(d, rel, content, subject) {
+  const p = join(d, rel)
+  mkdirSync(dirname(p), { recursive: true })
+  writeFileSync(p, content)
+  sh(d, ['add', '--', rel])
+  sh(d, ['commit', '-q', '-m', subject])
