+/** 固定变更名建 change 目录（basename 即变更名 → 「变更：」行内容确定，字节级断言可用） */
+function mkChange(name, decisionsMd) {
+  const root = mk('dff-')
+  const changeDir = join(root, name)
+  mkdirSync(changeDir, { recursive: true })
+  writeFileSync(join(changeDir, 'decisions.md'), decisionsMd)
+  return changeDir
+}
