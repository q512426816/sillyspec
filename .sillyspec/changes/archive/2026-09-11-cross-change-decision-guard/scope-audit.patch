+  mkdirSync(dirname(p), { recursive: true })
+  writeFileSync(p, content)
+  sh(d, ['add', '--', rel])
+  execFileSync('git', ['-C', d, 'commit', '-q', '-m', subject], {
+    encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'],
+    env: { ...process.env, GIT_AUTHOR_DATE: isoDate, GIT_COMMITTER_DATE: isoDate },
