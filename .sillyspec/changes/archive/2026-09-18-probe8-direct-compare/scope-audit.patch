+test('renderDirectCompareSection：命中统计行+明细行+全零行；渲染行不撞 PROBE8 两锚点正则', () => {
+  const lines = renderDirectCompareSection({
+    driftWarnings: [
+      { file: 'web/a.js', line: 4, field: 'drift1' },
+      { file: 'web/b.js', line: null, field: 'drift2' },
