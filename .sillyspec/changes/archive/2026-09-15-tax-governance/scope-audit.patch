+export function detectSelfMaintenanceTax(cwd, authoritySpecDir) {
+  const base = { name: 'self_maintenance_tax', label: '自维护税面（摩擦信号台账）', safe_actions: [] };
+  try {
+    const pointer = resolvePointer(cwd);
