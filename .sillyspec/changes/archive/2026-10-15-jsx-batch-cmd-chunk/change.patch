+    if (cur.length > 0 && curLen + add > maxLen) {
+      chunks.push(cur)
+      cur = []
+      curLen = prefix.length
+    }
+    cur.push(f)
+    curLen += add
+  }
+  if (cur.length > 0) chunks.push(cur)
+  return chunks
+}
