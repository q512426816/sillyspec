+    const key = computeCodeTreeKey({ cwd: dir })
+    assert.ok(typeof key === 'string' && key.length === 64, `大仓键应为 sha256 hex（修复前 null）：${key}`)
+    // 指纹链下游同仓恢复非 null（dedupKey/passedKey 依赖链）
+    mkdirSync(join(dir, '.sillyspec'), { recursive: true })
