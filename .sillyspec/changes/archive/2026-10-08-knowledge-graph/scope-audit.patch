+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>SillyHub · 知识图谱（原型）</title>
+<style>
+  :root{
+    --primary:#1677ff; --primary-bg:#e6f4ff;
+    --bg:#f5f6f8; --card:#ffffff; --border:#e5e7eb;
+    --text:#1f2328; --text-2:#57606a; --text-3:#8b949e;
+    --strong:#1677ff; --medium:#d97706; --weak:#9ca3af;
+    --danger:#dc2626; --ok:#16a34a;
+    --mono:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;
+  }
+  *{margin:0;padding:0;box-sizing:border-box}
+  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;background:var(--bg);color:var(--text);font-size:14px;height:100vh;display:flex;flex-direction:column;overflow:hidden}
+
+  /* ── 顶栏（平台页签） ── */
+  .topbar{height:52px;background:#001529;color:#fff;display:flex;align-items:center;padding:0 20px;gap:28px;flex-shrink:0}
+  .brand{display:flex;align-items:center;gap:8px;font-weight:600;font-size:15px}
+  .brand .logo{width:26px;height:26px;border-radius:6px;background:linear-gradient(135deg,#1677ff,#7c3aed);display:flex;align-items:center;justify-content:center;font-size:13px}
+  .tabs{display:flex;gap:4px;height:100%}
+  .tab{display:flex;align-items:center;padding:0 18px;cursor:pointer;color:rgba(255,255,255,.65);border-bottom:2px solid transparent;font-size:14px}
+  .tab:hover{color:#fff}
+  .tab.active{color:#fff;border-bottom-color:var(--primary);background:rgba(22,119,255,.15)}
+  .ws{margin-left:auto;display:flex;align-items:center;gap:10px;color:rgba(255,255,255,.65);font-size:13px}
+  .ws .dot{width:7px;height:7px;border-radius:50%;background:var(--ok)}
+  .badge-proto{background:rgba(255,255,255,.12);border:1px dashed rgba(255,255,255,.4);border-radius:4px;padding:1px 8px;font-size:11px;color:#fbbf24}
+
+  .main{flex:1;display:flex;min-height:0}
+
+  /* ── 左栏：查询 + 图例 ── */
+  .left{width:300px;background:var(--card);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0}
+  .sec{padding:14px 16px;border-bottom:1px solid var(--border)}
+  .sec h3{font-size:13px;color:var(--text-2);font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:6px}
+  .sec h3 .tag{font-size:10px;background:var(--primary-bg);color:var(--primary);border-radius:3px;padding:1px 5px;font-weight:500}
+  .qrow{display:flex;gap:6px;margin-bottom:8px}
+  .qrow select,.qrow input{border:1px solid var(--border);border-radius:6px;padding:6px 8px;font-size:12px;background:#fafbfc;outline:none;flex:1;min-width:0}
+  .qrow select{flex:0 0 96px;cursor:pointer}
+  .qrow input:focus,.qrow select:focus{border-color:var(--primary);box-shadow:0 0 0 2px rgba(22,119,255,.1)}
+  .btn{border:1px solid var(--primary);background:var(--primary);color:#fff;border-radius:6px;padding:6px 14px;font-size:12px;cursor:pointer;flex-shrink:0}
+  .btn:hover{background:#4096ff}
+  .btn.ghost{background:#fff;color:var(--primary)}
+  .btn.ghost:hover{background:var(--primary-bg)}
