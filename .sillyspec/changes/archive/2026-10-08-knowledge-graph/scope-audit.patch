+const walkFiles = (dir, base = dir) => {
+  let out = []
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    if (e.isDirectory()) out = out.concat(walkFiles(join(dir, e.name), base))
+    else out.push(join(dir, e.name).slice(base.length))
+  }
+  return out.sort()
+}
