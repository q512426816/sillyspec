+function splitProbeSectionRanges(text) {
+  const lines = String(text ?? '').split('\n')
+  const sections = []
+  let cur = null
+  for (let i = 0; i < lines.length; i++) {
+    const m = lines[i].match(PROBE_SECTION_HEADING_RE)
+    if (m) {
