+  const out = []
+  for (let i = 0; i <= lines.length; i++) {
+    const ins = insertions.get(i)
+    if (ins) out.push(...ins)
+    if (i === lines.length) break
+    const rep = replaceMap.get(i)
+    if (rep) {
+      out.push(rep.text)
+      i = rep.endLine - 1
+      continue
+    }
+    out.push(lines[i])
+  }
+  return { text: out.join('\n'), replaced, kept, appended, carriedRows }
+}
