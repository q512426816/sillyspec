+  }
+  try {
+    jsYaml.load(text)
+  } catch (e) {
+    return { ok: false, error: `local.yaml YAML 解析失败（${String(e && e.message ? e.message : e).split('\n')[0]}）——键清单不可信，先修复文件（doctor local_yaml_integrity 维度有指引）` }
