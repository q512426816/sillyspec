+    writeFileSync(join(dir, 'fr', 'auto-backend.md'), '# FR 索引 — auto-backend\n')
+    writeFileSync(join(dir, 'INDEX.md'), [
+      '# Knowledge Index', '',
+      '## FR 需求索引',
+      '- core-engine|FR|需求|承接 → [fr/core-engine.md](fr/core-engine.md)',
+      '',
+    ].join('\n'))
+    syncIndexRoutingLines(dir, {
