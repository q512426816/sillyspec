+    writeFileSync(join(dir, 'decisions', 'unmapped.md'), '# 决策知识 — unmapped\n\n## D-001@v1 图谱条目\n状态：rejected\n变更：2026-01-01-a\n否决理由：测试理由\n复潮条件：无\n')
+    const lines = []
