+      return { ok: false, error: 'local.yaml 顶层不是映射（YAML 合法但形态异常）——拒改，请人工核对' }
+    }
+  } catch (e) {
+    return { ok: false, error: `local.yaml YAML 解析失败（${String(e && e.message ? e.message : e).split('\n')[0]}）——拒改。先从备份/git 历史恢复或重建文件，再用本命令管理 known_failures` }
