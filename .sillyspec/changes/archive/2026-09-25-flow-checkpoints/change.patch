+  assert.deepEqual(rNone, { pushed: null, reason: 'no-config' })
+  // ③ 逃生阀 SILLYSPEC_WATCHER_PUSH=0 → {pushed:null}，零网络
+  const rOff = await pushEventsToPlatform({
