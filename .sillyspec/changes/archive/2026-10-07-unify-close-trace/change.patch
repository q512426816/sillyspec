+  writeFileSync(join(cwd, 'src', 'app.js'), 'module.exports = 1\n') // 未提交交付 → 实改行
+  const head = execFileSync('git', ['rev-parse', 'HEAD'], { cwd, encoding: 'utf8' }).trim()
