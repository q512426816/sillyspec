+/** 三类形态合集（R5 验收硬门重放入口） */
+export const WRONG_KEY_SHAPES = [PLURAL_MISMATCH, PAYLOAD_KEY_DRIFT, PATH_SEGMENT_SUFFIX_MISMATCH]

