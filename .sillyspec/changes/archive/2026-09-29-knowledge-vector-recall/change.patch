+    rmQuiet(root)
+  })
+})
+
+test('⑤⑥ 触发纪律：路由命中不调平台；开关关闭不调平台', async () => {
+  await withMock('ok', [{ spec_path: 'knowledge/decisions/unmapped.md', anchor: 'D-001@v1', score: 0.9 }], async (m) => {
+    // ⑤ 路由命中：查询含 tag「决策」
