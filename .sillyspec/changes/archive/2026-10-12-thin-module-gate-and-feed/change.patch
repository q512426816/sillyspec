+export function scanOrphanFace(cwd, { baseline } = {}) {
+  const empty = { commits: [], files: [] }
+  const git = (args, opts = {}) => {
+    try {
+      return execFileSync('git', args, { cwd, encoding: 'utf8', timeout: 60000, windowsHide: true, ...opts }).trim()
