+  } finally { clean(specBase) }
+}
+
+// ── quicklog 伪条目：归档新增失效 + 坏缓存 fail-open ──
+console.log('\n=== T3: 归档新增触发指纹失效 → 全量重建含新目录 ===')
+{
+  const specBase = setup('t3')
+  try {
+    mkArchive(specBase, '2026-01-01-alpha')
