+ *  归档根（dirStamp）＋ quicklog test-bindings。键序固定、数组排序——JSON 稳定比较。
+ *  各面缺席记 null（合法形态：无 docs/ 的小仓、无 fr 库）——缺席本身是指纹的一部分。 */
+function knowledgeGraphFingerprint(specRoot) {
+  const knowledgeDir = join(specRoot, 'knowledge')
