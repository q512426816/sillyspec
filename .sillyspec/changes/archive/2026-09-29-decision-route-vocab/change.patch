+      let mc = 0
+      for (const sh of hits) if (asciiWordHit(sh, text)) mc++
+      if (mc > 0) decisionHits.push({ ...h, score: mc })
+    }
+  }
+  decisionHits.sort((a, b) =>
+    (b.score - a.score) ||
+    (((b.status === 'rejected' || b.deathPath) ? 1 : 0) - ((a.status === 'rejected' || a.deathPath) ? 1 : 0))
+  )
