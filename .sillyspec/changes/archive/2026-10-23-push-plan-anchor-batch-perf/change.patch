+/**
+ * 批量解析锚点 commit（1 次 spawn 替代逐锚 rev-parse——43 锚 × 2 spawn 曾占 dry-run ~2.9s，
+ * 2026-10-23 实测）。`git cat-file --batch-check` 响应序=输入序（文档保证），按输入序对齐：
+ * 可解析回显 `<完整sha> commit <size>`（短哈希输入回显完整 sha，不能按回显内容反查短哈希
+ * 输入），缺失回显 `<输入> missing`。
+ * @returns {Map<string, string|null>} 输入 sha（原样）→ 解析后完整 sha；null=不可解析
+ */
+function batchCommitResolve(repoRoot, shas) {
+  const uniq = [...new Set(shas.map((s) => String(s || '').trim()).filter(Boolean))]
+  const map = new Map()
+  if (uniq.length === 0) return map
+  let out
+  try {
+    out = git(repoRoot, ['cat-file', '--batch-check'], {
+      input: uniq.map((s) => `${s}^{commit}`).join('\n') + '\n',
+      timeout: GIT_TIMEOUT, trim: false,
+    })
+  } catch { return map } // 整批失败：空 Map（调用方逐锚走不可解析路径，同向 fail 不洗白）
+  const lines = String(out).split('\n').map((l) => l.trim()).filter(Boolean)
+  for (let i = 0; i < uniq.length; i++) {
+    const line = lines[i]
+    if (!line || /\smissing$/.test(line)) { map.set(uniq[i], null); continue }
+    const full = line.split(/\s+/)[0]
+    map.set(uniq[i], /^[0-9a-f]{40,64}$/i.test(full) ? full : null)
+  }
+  return map
+}
