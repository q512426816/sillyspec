+const PUSH_TIMEOUT_DEFAULT_MS = 30_000;
+const CHUNK_OPS_DEFAULT = 128;
+const CHUNK_BYTES_DEFAULT = 2 * 1024 * 1024;
+
+function resolvePushTimeoutMs() {
+  const raw = Number(process.env.SILLYSPEC_SPEC_SYNC_PUSH_TIMEOUT_MS);
