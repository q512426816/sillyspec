+/**
+ * 2026-11-04-sync-push-chunking 回归：spec 树推送分批化。
+ *
+ * 生产实证（multi-agent-platform 工作区）：15 天积压 2436 ops/45.7MB 单批 POST 在
+ * 「清单 10s / 推送 30s」单请求预算内上传+服务端 apply 双超，37 连败 400/中断，
+ * spec_version 冻结零落地。分批顺序推送（op 数 + base64 字节数双约束切块）后：
+ * 每块独立提交在预算内；已落地块推进服务器清单；中途失败下轮 diff 断点续传。
+ *
+ * 三层断言：
+ *   A. chunkOpsForPush 纯逻辑边界（阈值恰好/超出、单 op 超字节独占一块、双约束同时生效、序保序）；
+ *   B. syncSpecTree 集成：多块全部落地（服务器收到 N 个 POST、总和=ops 数、synced 正确）；
+ *   C. 中途块 HTTP 500：已落地块保留语义（ok:false、服务器只见前 i 块）。
+ */
+import http from 'node:http'
+import { mkdtempSync, mkdirSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { syncSpecTree, chunkOpsForPush } from '../src/spec-sync.js'
+
+let failures = 0
+const assert = (cond, msg) => {
+  if (cond) console.log('  ✅ ' + msg)
+  else { console.error('  ❌ ' + msg); failures++; }
+}
+
+const tmpRoot = mkdtempSync(join(tmpdir(), `sync-chunk-${process.pid}-`))
+const mkOp = (path, contentLen = 0) => ({ op: 'add', path, base_version: 0, content: 'x'.repeat(contentLen) })
+
+// ── A. chunkOpsForPush 纯逻辑 ──
+console.log('\n--- A. chunkOpsForPush 双约束切块 ---')
+{
+  const single = [mkOp('a.md')]
+  assert(chunkOpsForPush(single, { maxOps: 4, maxBytes: 1024 }).length === 1, '单 op 单块')
+
+  const exact = [mkOp('a'), mkOp('b'), mkOp('c')]
+  assert(chunkOpsForPush(exact, { maxOps: 3, maxBytes: 1 << 20 }).length === 1, '恰好等于 ops 阈值=1 块（触发条件是「已有块满再来新 op」）')
+
+  const four = [mkOp('a'), mkOp('b'), mkOp('c'), mkOp('d')]
+  const byOps = chunkOpsForPush(four, { maxOps: 3, maxBytes: 1 << 20 })
+  assert(byOps.length === 2 && byOps[0].length === 3 && byOps[1].length === 1, `ops 阈值切块 3+1（实得 ${byOps.map((c) => c.length).join('+')}）`)
+
+  // 尺寸粗估=content+path×2+96：4000B op ≈ 4098；a+b=8196>8192 切块，c（≈108B）并入第二块
+  const byBytes = chunkOpsForPush([mkOp('a', 4000), mkOp('b', 4000), mkOp('c', 10)], { maxOps: 100, maxBytes: 8192 })
+  assert(byBytes.length === 2 && byBytes[0].length === 1 && byBytes[1].length === 2, `字节阈值切块 1+2（实得 ${byBytes.map((c) => c.length).join('+')}）`)
+
+  const both = chunkOpsForPush([mkOp('a', 100), mkOp('b', 100), mkOp('c', 100)], { maxOps: 2, maxBytes: 250 })
+  assert(both.length === 3, `双约束同时生效取更严（实得 ${both.length} 块）`)
+
+  const huge = [mkOp('huge.bin', 99999)]
+  const oneHuge = chunkOpsForPush(huge, { maxOps: 8, maxBytes: 100 })
+  assert(oneHuge.length === 1 && oneHuge[0].length === 1, '超字节单 op 独占一块（不切不丢弃不死循环）')
+
+  const ordered = [1, 2, 3, 4, 5].map((i) => mkOp(`f${i}`))
+  const flat = chunkOpsForPush(ordered, { maxOps: 2, maxBytes: 1 << 20 }).flat().map((o) => o.path)
+  assert(JSON.stringify(flat) === JSON.stringify(ordered.map((o) => o.path)), '切块保序（flatten 等于原序）')
+
+  assert(chunkOpsForPush([], { maxOps: 2, maxBytes: 100 }).length === 0, '空 ops 零块（调用方已有 ops.length===0 短路，防御）')
+}
+
+// ── 集成 mock 服务器：manifest 返回空清单（全部本地文件 → add ops）──
+let posts = [] // 每次 spec-sync POST 的 { opsCount, status }
+const server = http.createServer((req, res) => {
+  if (req.url.includes('/api/changes/-/spec-manifest')) {
+    res.writeHead(200, { 'Content-Type': 'application/json' })
+    res.end(JSON.stringify({ files: {}, spec_version: 1 }))
+    return
+  }
+  if (req.url.includes('/api/changes/-/spec-sync') && req.method === 'POST') {
+    let raw = ''
+    req.on('data', (d) => { raw += d })
+    req.on('end', () => {
+      let opsCount = 0
+      try { opsCount = JSON.parse(raw).ops.length } catch { /* 保持 0 */ }
+      const seq = posts.length
+      posts.push({ opsCount, seq })
+      // C 组用例：第 2 块（seq=1）回 500
+      if (process.env.SYNC_CHUNK_FAIL_SECOND === '1' && seq === 1) {
+        res.writeHead(500, { 'Content-Type': 'application/json' })
+        res.end(JSON.stringify({ code: 'internal_error', message: 'mock fail' }))
+        return
+      }
+      res.writeHead(200, { 'Content-Type': 'application/json' })
+      res.end(JSON.stringify({ ok: true, new_versions: {}, conflict: false, platform_deleted: [] }))
+    })
+    return
+  }
+  res.writeHead(404); res.end()
+})
+await new Promise((r) => server.listen(0, '127.0.0.1', r))
+const mockUrl = `http://127.0.0.1:${server.address().port}`
+
+const makeSpec = (sub, fileCount) => {
+  const specDir = join(tmpRoot, sub)
+  mkdirSync(specDir, { recursive: true })
+  for (let i = 0; i < fileCount; i++) writeFileSync(join(specDir, `f${i}.md`), `content ${i}\n`)
+  return specDir
+}
+
+// ── B. 多块全部落地 ──
+console.log('\n--- B. 12 ops 按 env CHUNK_OPS=5 → 3 块顺序提交全部落地 ---')
+{
+  posts = []
+  const prevOps = process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS
+  process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS = '5'
+  try {
+    const specDir = makeSpec('multi', 12)
+    const r = await syncSpecTree(specDir, { url: mockUrl, token: 'tok' }, 'chunk-chg', {})
+    assert(r && r.ok === true && r.synced === 12, `全部落地 synced=12 ok=true（实得 ${JSON.stringify(r && { ok: r.ok, synced: r.synced })}）`)
+    assert(posts.length === 3, `服务器收到 3 次 POST（实得 ${posts.length}）`)
+    assert(posts.map((p) => p.opsCount).join('+') === '5+5+2', `块内 ops 5+5+2（实得 ${posts.map((p) => p.opsCount).join('+')}）`)
+  } finally {
+    if (prevOps === undefined) delete process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS
+    else process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS = prevOps
+  }
+}
+
+// ── C. 第 2 块 500 → 已落地块保留、ok:false、服务器只见前 2 块 ──
+console.log('\n--- C. 中途块 500 → ok:false、已落地 1 块保留、下轮 diff 续传 ---')
+{
+  posts = []
+  const prevOps = process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS
+  process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS = '4'
+  process.env.SYNC_CHUNK_FAIL_SECOND = '1'
+  try {
+    const specDir = makeSpec('failmid', 12)
+    const r = await syncSpecTree(specDir, { url: mockUrl, token: 'tok' }, 'chunk-fail', {})
+    assert(r && r.ok === false && r.synced === 0, `中途失败返回 ok:false synced=0（实得 ${JSON.stringify(r && { ok: r.ok, synced: r.synced })}）`)
+    assert(posts.length === 2, `失败即停：服务器只见 2 次 POST（第 1 块已落地 + 第 2 块 500）（实得 ${posts.length}）`)
+  } finally {
+    if (prevOps === undefined) delete process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS
+    else process.env.SILLYSPEC_SPEC_SYNC_CHUNK_OPS = prevOps
+    delete process.env.SYNC_CHUNK_FAIL_SECOND
+  }
+}
+
+server.closeAllConnections?.()
+await new Promise((r) => server.close(r))
+console.log(`\n${failures === 0 ? '✅ sync-push-chunking 全部通过' : '❌ 存在失败'}（失败 ${failures}）`)
+process.exitCode = failures === 0 ? 0 : 1
