+    '        submit(o);',
+    '    }',
+    '    public void deleteOrder(Long id) {',
+    '        repo.deleteById(id);',
+    '    }',
+    '}',
+  ].join('\n')
+  const fx = mkFixture({ prefix: 'p9g-anno-', java })
