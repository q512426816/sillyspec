+  if (s) {
+    for (const line of String(s).split('\n')) {
+      if (!line || line.length < 4) continue
+      const p = line.slice(3).trim().replace(/^"|"$/g, '')
+      const arrow = p.indexOf(' -> ')
+      const path = arrow !== -1 ? p.slice(arrow + 4) : p
+      addIfDeliverable(path)
+    }
+  }
