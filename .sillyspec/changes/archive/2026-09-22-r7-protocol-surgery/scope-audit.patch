+    const runtimeRoot = resolveRuntimeRoot({}, specBase)
+    const { amendFlowDraft } = await import('./flow-draft.js')
+    const r = amendFlowDraft({ changeDir, change, runtimeRoot })
+    if (r.reanchored.length === 0) {
