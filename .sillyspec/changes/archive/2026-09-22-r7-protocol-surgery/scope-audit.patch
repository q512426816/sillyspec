+      process.exit(1)
+    }
+    // 切片四：editRatio 路由信号（D-005 advisory 定案——测绿可薄档过；超阈提示+route_hint 落档）
+    const cfg = readFlowConfig(specBase)
+    // 路由信号取段级最大改写比（任一段过半=该段决策未被输入覆盖——聚合比会被未改段稀释）；
