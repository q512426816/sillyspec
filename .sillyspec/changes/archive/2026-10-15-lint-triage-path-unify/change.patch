+
+test('鉴定链异常（importer 抛错）→ 返回 false 保守硬拦', async () => {
+  const ok = await lintOwnershipDowngrade({
+    ...base,
+    lintCheck,
+    importer: mkImporter({ throwOnLoad: true }),
