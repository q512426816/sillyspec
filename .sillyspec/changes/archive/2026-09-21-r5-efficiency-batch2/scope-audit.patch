+export function recommendWaveGroups(tasks) {
+  if (!Array.isArray(tasks)) return []
+  const list = tasks.map(t => ({
+    id: padTaskRef(t?.id ?? ''),
+    files: t?.files == null ? null : new Set([...t.files].map(String)),
