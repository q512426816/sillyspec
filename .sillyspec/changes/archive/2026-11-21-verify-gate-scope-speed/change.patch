+  assert.ok((withAttr.attribution['test/lib.test.mjs'] || []).includes('src/lib.js'), 'attribution：测试文件→命中源列表')
+  assert.equal(withAttr.hitCountBySrc['src/lib.js'], 1, 'hitCountBySrc：源→命中测试数')
