+  assert.ok(!s.blocking.some(f => /^test\/hub-\d+\.test\.mjs$/.test(f)), '枢纽命中测试全部移出阻断面')
+  assert.ok(s.blocking.includes('test/hub-own.test.mjs'), '自身测试（hub-own）留阻断面——归因缺失/自身测试 fail-open 多跑侧不变量')
