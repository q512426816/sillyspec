+/**
+ * 从 full.json 生成可读性优先的单文件 HTML 分析页
+ */
+import { readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+const DIR = join(
+  process.cwd(),
+  'round5',
+  'exports',
+  'R9-SF_sess_subagent_agent_7d5faf40-f0bc-4066-9201-aa7eb3c61570',
+);
+const full = JSON.parse(readFileSync(join(DIR, 'full.json'), 'utf8'));
+
+/**
+ * Bash 命令三类：
+ * - sillyspec：实际调用 sillyspec CLI（bin/sillyspec.js / sillyspec 子命令），不单凭路径含 .sillyspec
+ * - test：pytest / vitest / mypy / ruff / typecheck / pnpm|npm test|lint 等门禁与测试
+ * - other：其余 shell
+ */
+function classifyBash(cmd) {
+  const c = String(cmd || '');
+  // 路径常含 `.sillyspec/`，先抹掉再判 CLI，避免假阳性
+  const noDotDir = c.replace(/\.sillyspec\b/gi, '.SSDIR');
+
+  const isSillyCli =
+    /sillyspec\.js\b/i.test(noDotDir) ||
+    /[/\\]bin[/\\]sillyspec(?:\.js)?\b/i.test(noDotDir) ||
+    /(?:^|[\s"'`;|&])sillyspec(?:\.cmd)?\b/i.test(noDotDir) ||
+    (/SILLYSPEC_[A-Z0-9_]+=/.test(c) &&
+      (/sillyspec\.js\b/i.test(c) || /[/\\]bin[/\\]sillyspec/i.test(c) || /\bsillyspec\b/i.test(noDotDir)));
+
+  if (isSillyCli) return 'sillyspec';
+
+  // 去掉引号串，避免 grep "mypy|ruff|test" 探查命令被误判为测试执行
+  const forTest = c.replace(/"(?:\\.|[^"\\])*"/g, '""').replace(/'(?:\\.|[^'\\])*'/g, "''");
+
+  if (
+    /\b(?:uv\s+run\s+)?pytest\b/i.test(forTest) ||
+    /\bvitest\b/i.test(forTest) ||
+    /\bpnpm\s+(?:test|typecheck|lint)\b/i.test(forTest) ||
+    /\bnpm\s+(?:test|run\s+lint)\b/i.test(forTest) ||
+    /\b(?:uv\s+run\s+)?mypy\b/i.test(forTest) ||
+    /\bruff\s+(?:check|format)\b/i.test(forTest) ||
+    /\btsc\s+--noEmit\b/i.test(forTest) ||
+    /\btsc\b/i.test(forTest) && /\b--noEmit\b/i.test(forTest)
+  ) {
+    return 'test';
+  }
+  return 'other';
+}
+
+function summarizeBashKinds(timeline) {
+  const counts = { sillyspec: 0, test: 0, other: 0 };
+  for (const m of timeline) {
+    for (const p of m.parts || []) {
+      if (p.type === 'tool' && p.name === 'Bash' && p.bash_kind) {
+        counts[p.bash_kind] = (counts[p.bash_kind] || 0) + 1;
+      }
+    }
+  }
+  return counts;
+}
+
+function bashCommandOf(input) {
+  if (!input || typeof input !== 'object') return '';
+  return String(input.command || input.cmd || '');
+}
+
+/** 压缩时间线条目，去掉 step-start/finish 噪音，保留分析用字段 */
+function compactTimeline(timeline) {
+  return timeline.map((m) => {
+    const role = m.message?.role || 'unknown';
+    const finish = m.message?.finish || null;
+    const model = m.message?.modelId || m.message?.model?.modelID || null;
+    const agent = m.message?.agent || null;
+    const semantics = m.message?.semantics || null;
+    const synthetic = !!m.message?.synthetic;
+    const source = m.message?.source || null;
+    const tokens = m.message?.tokens || null;
+    const cost = m.message?.cost || null;
+
+    const parts = [];
+    for (const p of m.parts || []) {
+      const d = p.data || {};
+      const type = d.type;
+      if (type === 'step-start' || type === 'step-finish') continue;
+      if (type === 'timeline') {
+        parts.push({ type: 'timeline', title: d.title || '' });
+        continue;
+      }
+      if (type === 'text') {
+        parts.push({ type: 'text', text: d.text || '' });
+        continue;
+      }
+      if (type === 'reasoning') {
+        parts.push({ type: 'reasoning', text: d.text || d.content || '' });
+        continue;
+      }
+      if (type === 'tool') {
+        const st = d.state || {};
+        const name = d.tool || d.name || '?';
+        const input = st.input ?? d.input ?? null;
+        const entry = {
+          type: 'tool',
+          name,
+          status: st.status || '',
+          title: st.title || '',
+          input,
+          output: st.output !== undefined ? st.output : null,
+          error: st.error !== undefined ? st.error : null,
+          duration_ms: st.metadata?.duration_ms ?? st.time?.end - st.time?.start ?? null,
+        };
+        if (name === 'Bash') {
+          const cmd = bashCommandOf(input);
+          entry.bash_kind = classifyBash(cmd);
+          entry.command = cmd;
+        }
+        parts.push(entry);
+        continue;
+      }
+      parts.push({ type: type || 'unknown', raw: d });
+    }
+
+    return {
+      seq: m.sequence,
+      id: m.id,
+      time: m.time_created,
+      time_zh: m.time_created_zh,
+      role,
+      finish,
+      model,
+      agent,
+      synthetic,
+      source,
+      semantics,
+      tokens,
+      cost,
+      parts,
+    };
+  });
+}
+
+const payload = {
+  meta: {
+    session_id: full.session_id,
+    parent_session_id: full.parent_session_id,
+    title: full.title,
+    directory: full.session_meta?.directory,
+    path: full.session_meta?.path,
+    version: full.session_meta?.version,
+    task_type: full.session_meta?.task_type,
+    time_created: full.session_meta?.time_created,
+    time_updated: full.session_meta?.time_updated,
+    time_created_zh: full.session_meta?.time_created_zh,
+    time_updated_zh: full.session_meta?.time_updated_zh,
+    duration_min: full.session_meta?.duration_ms
+      ? +(full.session_meta.duration_ms / 60000).toFixed(1)
+      : null,
+    exported_at_zh: full.exported_at_zh,
+    counts: full.counts,
+  },
+  todos: (full.todos || []).map((t) => ({
+    content: t.content,
+    status: t.status,
+    priority: t.priority,
+    position: t.position,
+  })),
+  session_input: (full.session_input || []).map((s) => ({
+    status: s.status,
+    delivery: s.delivery,
+    text: s.payload?.text || JSON.stringify(s.payload),
+    time: s.time_created,
+  })),
+  turn_usage: full.turn_usage || [],
+  model_usage_summary: summarizeUsage(full.model_usage || []),
+  tool_usage_summary: summarizeTools(full.tool_usage || []),
+  timeline: compactTimeline(full.timeline || []),
+};
+
+function summarizeUsage(rows) {
+  const s = {
+    n: rows.length,
+    input: 0,
+    output: 0,
+    cache_read: 0,
+    duration_ms: 0,
+    models: {},
+    finish: {},
+    status: {},
+  };
+  for (const r of rows) {
+    s.input += r.input_tokens || 0;
+    s.output += r.output_tokens || 0;
+    s.cache_read += r.cache_read_input_tokens || 0;
+    s.duration_ms += r.duration_ms || 0;
+    if (r.model_id) s.models[r.model_id] = (s.models[r.model_id] || 0) + 1;
+    if (r.finish_reason) s.finish[r.finish_reason] = (s.finish[r.finish_reason] || 0) + 1;
+    if (r.status) s.status[r.status] = (s.status[r.status] || 0) + 1;
+  }
+  s.cache_pct = s.input ? +((s.cache_read / s.input) * 100).toFixed(1) : 0;
+  return s;
+}
+
+function summarizeTools(rows) {
+  const by = {};
+  const status = {};
+  let err = 0;
+  for (const r of rows) {
+    by[r.tool_name] = (by[r.tool_name] || 0) + 1;
+    status[r.status] = (status[r.status] || 0) + 1;
+    if (r.status === 'error') err++;
+  }
+  return { by, status, err, n: rows.length };
+}
+
+const STAGE_ORDER = ['setup', 'brainstorm', 'plan', 'execute', 'verify', 'archive', 'wrapup'];
+const STAGE_LABEL = {
+  setup: '环境准备',
+  brainstorm: '头脑风暴',
+  plan: '计划',
+  execute: '执行',
+  verify: '验证',
+  archive: '归档',
+  wrapup: '收尾/报告',
+};
+
+function annotateStages(timeline) {
+  let current = 'setup';
+  for (const m of timeline) {
+    const detected = detectStageTransition(m);
+    if (detected) current = detected;
+    m.stage = current;
+  }
+}
+
+function detectStageTransition(m) {
+  // 系统合成消息（Todo 提醒等）常夹带 todo 文案「终态自查报告」，不得切阶段
+  if (m.synthetic) return null;
+
+  for (const p of m.parts || []) {
+    if (p.type !== 'text' || !p.text) continue;
+    const t = p.text;
+    const start = t.match(/\*\*\s*(brainstorm|plan|execute|verify|archive)\s*开始\s*[：:]/i);
+    if (start) return start[1].toLowerCase();
+    const enter = t.match(/进入\s*(brainstorm|plan|execute|verify|archive)\s*阶段/i);
+    if (enter) return enter[1].toLowerCase();
+    if (m.role === 'assistant' && /启动\s*brainstorm/i.test(t)) return 'brainstorm';
+    // 仅认最终报告标题，避免 todo 列表文案误触
+    if (
+      m.role === 'assistant' &&
+      /#\s*R9-SF\s*受试会话终态自查报告|#\s*.*终态自查报告/i.test(t) &&
+      t.length > 800
+    ) {
+      return 'wrapup';
+    }
+  }
+  for (const p of m.parts || []) {
+    if (p.type !== 'tool' || p.name !== 'Bash' || !p.command) continue;
+    const noDot = p.command.replace(/\.sillyspec\b/gi, '.SSDIR');
+    const run = noDot.match(
+      /sillyspec(?:\.js)?["']?\s+run\s+(brainstorm|plan|execute|verify|archive)\b/i,
+    );
+    if (run) return run[1].toLowerCase();
+    const complete = noDot.match(
+      /complete-stage\s+(brainstorm|plan|execute|verify|archive)\b/i,
+    );
+    if (complete) return complete[1].toLowerCase();
+  }
+  return null;
+}
+
+function summarizeStages(timeline) {
+  const map = new Map();
+  for (const m of timeline) {
+    const s = m.stage || 'setup';
+    if (!map.has(s)) {
+      map.set(s, {
+        id: s,
+        label: STAGE_LABEL[s] || s,
+        seq_from: m.seq,
+        seq_to: m.seq,
+        time_from: m.time_zh || m.time,
+        time_to: m.time_zh || m.time,
+        messages: 0,
+        bash: { sillyspec: 0, test: 0, other: 0 },
+        tools: 0,
+      });
+    }
+    const row = map.get(s);
+    row.seq_to = m.seq;
+    row.time_to = m.time_zh || m.time;
+    row.messages += 1;
+    for (const p of m.parts || []) {
+      if (p.type === 'tool') {
+        row.tools += 1;
+        if (p.name === 'Bash' && p.bash_kind) {
+          row.bash[p.bash_kind] = (row.bash[p.bash_kind] || 0) + 1;
+        }
+      }
+    }
+  }
+  return STAGE_ORDER.filter((id) => map.has(id)).map((id) => map.get(id));
+}
+
+payload.bash_kind_summary = summarizeBashKinds(payload.timeline);
+annotateStages(payload.timeline);
+payload.stage_summary = summarizeStages(payload.timeline);
+
+const json = JSON.stringify(payload).replace(/</g, '\\u003c');
