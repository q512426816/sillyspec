+      <table class="mini">
+        <thead><tr><th>阶段</th><th>seq</th><th>时间</th><th>消息</th><th>工具</th><th>Bash(s/t/o)</th></tr></thead>
+        <tbody>\${stageRows}</tbody>
+      </table>
+      <div style="font-size:.75rem;color:var(--muted);margin-top:8px">点击顶栏阶段卡片可只看该阶段；时间线内按阶段插入分隔条。</div>
+    </div>
+    <div class="panel">
+      <h2>Bash 三类分布</h2>
+      <table class="mini">
+        <thead><tr><th>类别</th><th>次数</th><th>占比</th></tr></thead>
+        <tbody>
+          <tr><td><span class="tag bash-silly">sillyspec CLI</span></td><td>\${bk.sillyspec||0}</td><td>\${bashTotal?(((bk.sillyspec||0)/bashTotal)*100).toFixed(1):0}%</td></tr>
+          <tr><td><span class="tag bash-test">测试/门禁</span></td><td>\${bk.test||0}</td><td>\${bashTotal?(((bk.test||0)/bashTotal)*100).toFixed(1):0}%</td></tr>
+          <tr><td><span class="tag bash-other">其它 shell</span></td><td>\${bk.other||0}</td><td>\${bashTotal?(((bk.other||0)/bashTotal)*100).toFixed(1):0}%</td></tr>
+          <tr><td><b>合计</b></td><td>\${bashTotal}</td><td>100%</td></tr>
+        </tbody>
+      </table>
+      <div class="bash-legend">
+        <span class="tag bash-silly">sillyspec</span> 实际调用 bin/sillyspec.js（忽略路径里的 .sillyspec 目录）
+        <span class="tag bash-test">测试</span> 实际跑 pytest / vitest / mypy / ruff check|format / tsc / pnpm test|lint|typecheck（grep 探查不算）
+        <span class="tag bash-other">其它</span> git / ls / curl / install 等
+      </div>
+    </div>
+    <div class="panel">
+      <h2>工具分布</h2>
+      <table class="mini"><thead><tr><th>工具</th><th>次数</th></tr></thead><tbody>\${toolRows}</tbody></table>
+    </div>
+    <div class="panel">
+      <h2>Todos</h2>
+      <ul style="margin:0;padding-left:18px;font-size:.85rem">\${todos}</ul>
+    </div>
+    <div class="panel" style="grid-column:1/-1">
+      <h2>协调者 / Session Input</h2>
+      \${inputs}
+    </div>
+    <div class="panel" style="grid-column:1/-1">
+      <h2>用量摘要</h2>
+      <table class="mini">
+        <tr><th>模型</th><td>\${esc(JSON.stringify(u.models))}</td></tr>
+        <tr><th>finish</th><td>\${esc(JSON.stringify(u.finish))}</td></tr>
+        <tr><th>模型耗时合计</th><td>\${((u.duration_ms||0)/60000).toFixed(1)} min</td></tr>
+        <tr><th>有效新 input（约）</th><td>\${fmtNum((u.input||0)-(u.cache_read||0))}</td></tr>
+      </table>
+    </div>
+  \`;
+}
+
+function fillToolSelect() {
+  const set = new Set();
+  for (const m of DATA.timeline) for (const n of toolsOf(m)) set.add(n);
+  const sel = document.getElementById('tool');
+  [...set].sort().forEach(name => {
+    const o = document.createElement('option');
+    o.value = name; o.textContent = name;
+    sel.appendChild(o);
+  });
+  const stageSel = document.getElementById('stage');
+  (DATA.stage_summary || []).forEach(s => {
+    const o = document.createElement('option');
+    o.value = s.id;
+    o.textContent = s.label + ' (#' + s.seq_from + '–' + s.seq_to + ')';
+    stageSel.appendChild(o);
+  });
+}
+
+function renderNav(matched) {
+  const nav = document.getElementById('nav');
+  let html = '';
+  let lastStage = null;
+  matched.forEach(m => {
+    if (m.stage !== lastStage) {
+      lastStage = m.stage;
+      html += '<div class="nav-stage-label">' + esc(STAGE_LABEL[m.stage] || m.stage || '?') + '</div>';
+    }
+    const tags = [];
+    const ts = toolsOf(m);
+    const bks = [...new Set(bashKindsOf(m))];
+    for (const k of bks) {
+      tags.push('<span class="tag bash-' + (k === 'sillyspec' ? 'silly' : k) + '">Bash/' + esc(BASH_KIND_LABEL[k] || k) + '</span>');
+    }
+    if (ts.filter(n => n !== 'Bash').length) {
+      const others = ts.filter(n => n !== 'Bash');
+      tags.push('<span class="tag tool">' + esc(others[0]) + (others.length>1?' +'+(others.length-1):'') + '</span>');
+    }
+    if (hasError(m)) tags.push('<span class="tag err">error</span>');
+    if (m.synthetic) tags.push('<span class="tag syn">synthetic</span>');
+    if (m.finish) tags.push('<span class="tag">' + esc(m.finish) + '</span>');
+    html += '<div class="nav-item" data-seq="' + m.seq + '">' +
+      '<div class="seq">#' + m.seq + '</div>' +
+      '<div class="meta"><div class="role ' + esc(m.role) + '">' + esc(m.role) + '</div>' +
+      '<div class="preview">' + esc(previewOf(m)) + '</div>' +
+      '<div class="tags">' + tags.join('') + '</div></div></div>';
+  });
+  nav.innerHTML = html || '<div class="empty">无匹配</div>';
+  nav.querySelectorAll('.nav-item').forEach(el => {
+    el.addEventListener('click', () => {
+      const seq = el.getAttribute('data-seq');
+      const target = document.getElementById('msg-' + seq);
+      if (target) {
+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        nav.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
+        el.classList.add('active');
+      }
+    });
+  });
+}
+
+function partHtml(p, autoOpenText = true) {
+  if (p.type === 'text') {
+    return '<div class="part text open"><div class="part-h"><span class="pill">text</span><span>回复 / 提示</span></div>' +
+      '<div class="part-b"><div class="text-body prose">' + esc(p.text) + '</div></div></div>';
+  }
+  if (p.type === 'reasoning') {
+    return '<div class="part reasoning"><div class="part-h" data-toggle><span class="pill">reasoning</span><span>推理（点击展开）</span><span style="margin-left:auto;color:var(--muted)">' + (p.text||'').length + ' chars</span></div>' +
+      '<div class="part-b"><pre class="block">' + esc(p.text) + '</pre></div></div>';
+  }
+  if (p.type === 'tool') {
+    const err = p.status === 'error' || p.error;
+    const openClass = err ? ' open' : '';
+    const out = p.error != null ? p.error : p.output;
+    const outStr = typeof out === 'string' ? out : JSON.stringify(out, null, 2);
+    const inStr = JSON.stringify(p.input ?? {}, null, 2);
+    const bashKind = p.name === 'Bash' ? (p.bash_kind || 'other') : null;
+    const bashCls = bashKind ? ' bash-' + (bashKind === 'sillyspec' ? 'silly' : bashKind) : '';
+    const bashPill = bashKind
+      ? '<span class="pill bash-' + (bashKind === 'sillyspec' ? 'silly' : bashKind) + '">Bash · ' + esc(BASH_KIND_LABEL[bashKind] || bashKind) + '</span>'
+      : '';
+    const cmdPreview = bashKind && p.command
+      ? '<div style="font-size:.72rem;color:var(--muted);margin:0 0 8px;font-family:var(--mono);white-space:pre-wrap;word-break:break-word">' + esc(p.command) + '</div>'
+      : '';
+    return '<div class="part tool' + bashCls + (err?' error':'') + openClass + '"><div class="part-h" data-toggle>' +
+      '<span class="pill' + (err?' err':'') + '">tool</span><span>' + esc(p.name) + '</span>' + bashPill +
+      (p.title ? '<span style="color:var(--muted);font-weight:500">· ' + esc(p.title) + '</span>' : '') +
+      '<span class="pill" style="margin-left:auto">' + esc(p.status || '') + '</span></div>' +
+      '<div class="part-b">' + cmdPreview +
+      '<div style="font-size:.75rem;color:var(--muted);margin-bottom:6px">input</div><pre class="block">' + esc(inStr) + '</pre>' +
+      '<div style="font-size:.75rem;color:var(--muted);margin:10px 0 6px">' + (p.error != null ? 'error' : 'output') + '</div>' +
+      '<pre class="block">' + esc(outStr ?? '') + '</pre></div></div>';
+  }
+  if (p.type === 'timeline') {
+    return '<div class="part open"><div class="part-h"><span class="pill">timeline</span>' + esc(p.title) + '</div></div>';
+  }
+  return '<div class="part open"><div class="part-h"><span class="pill">' + esc(p.type) + '</span></div>' +
+    '<div class="part-b"><pre class="block">' + esc(JSON.stringify(p.raw || p, null, 2)) + '</pre></div></div>';
+}
+
+function renderFeed(matched) {
+  const set = new Set(matched.map(m => m.seq));
+  const feed = document.getElementById('feed');
+  if (!feed.dataset.ready) {
+    const stageMeta = Object.fromEntries((DATA.stage_summary || []).map(s => [s.id, s]));
+    let html = '';
+    let lastStage = null;
+    DATA.timeline.forEach(m => {
+      if (m.stage !== lastStage) {
+        lastStage = m.stage;
+        const meta = stageMeta[m.stage] || {};
+        html += '<div class="stage-banner ' + esc(m.stage || '') + '" id="stage-banner-' + esc(m.stage || '') + '" data-stage="' + esc(m.stage || '') + '">' +
+          '<h3>' + esc(STAGE_LABEL[m.stage] || m.stage || '阶段') + '</h3>' +
+          '<div class="sub">' +
+          '<span>seq #' + (meta.seq_from ?? m.seq) + '–' + (meta.seq_to ?? m.seq) + '</span>' +
+          '<span>' + esc(meta.time_from || '') + ' → ' + esc(meta.time_to || '') + '</span>' +
+          '<span>' + (meta.messages || 0) + ' 条消息</span>' +
+          '<span>Bash s/t/o: ' + (meta.bash?.sillyspec||0) + '/' + (meta.bash?.test||0) + '/' + (meta.bash?.other||0) + '</span>' +
+          '</div></div>';
+      }
+      const err = hasError(m);
+      html += '<article class="msg ' + esc(m.role) + '" id="msg-' + m.seq + '" data-seq="' + m.seq + '" data-stage="' + esc(m.stage || '') + '">' +
+        '<div class="msg-head">' +
+        '<span class="badge ' + esc(m.role) + '">' + esc(m.role) + '</span>' +
+        '<span class="tag">' + esc(STAGE_LABEL[m.stage] || m.stage || '') + '</span>' +
+        '<span class="time">#' + m.seq + ' · ' + esc(m.time_zh || m.time || '') + '</span>' +
+        (m.finish ? '<span class="tag">' + esc(m.finish) + '</span>' : '') +
+        (m.model ? '<span class="tag">' + esc(m.model) + '</span>' : '') +
+        (m.synthetic ? '<span class="tag syn">synthetic</span>' : '') +
+        (err ? '<span class="tag err">tool error</span>' : '') +
+        '<span class="id">' + esc(m.id) + '</span>' +
+        '</div><div class="msg-body">' + m.parts.map(p => partHtml(p)).join('') + '</div></article>';
+    });
+    feed.innerHTML = html;
+    feed.dataset.ready = '1';
+    feed.addEventListener('click', (e) => {
+      const h = e.target.closest('[data-toggle]');
+      if (!h) return;
+      h.parentElement.classList.toggle('open');
+    });
+  }
+  feed.querySelectorAll('.msg').forEach(el => {
+    const seq = +el.dataset.seq;
+    el.classList.toggle('hidden-by-filter', !set.has(seq));
+  });
+  // 阶段横幅：该阶段下若无可见消息则隐藏
+  feed.querySelectorAll('.stage-banner').forEach(banner => {
+    const st = banner.getAttribute('data-stage');
+    const any = matched.some(m => m.stage === st);
+    banner.classList.toggle('hidden-by-filter', !any);
+  });
+  document.getElementById('matchCount').textContent = matched.length;
+  document.getElementById('totalCount').textContent = DATA.timeline.length;
+}
+
+function apply() {
+  const matched = DATA.timeline.filter(matches);
+  renderNav(matched);
+  renderFeed(matched);
+  renderStageTabs();
+}
+
+function bind() {
+  document.getElementById('q').addEventListener('input', e => { state.q = e.target.value; apply(); });
+  document.getElementById('role').addEventListener('change', e => { state.role = e.target.value; apply(); });
+  document.getElementById('tool').addEventListener('change', e => { state.tool = e.target.value; apply(); });
+  document.getElementById('bashKind').addEventListener('change', e => { state.bashKind = e.target.value; apply(); });
+  document.getElementById('stage').addEventListener('change', e => {
+    state.stage = e.target.value;
+    apply();
+    if (state.stage !== 'all') {
+      const banner = document.getElementById('stage-banner-' + state.stage);
+      if (banner) banner.scrollIntoView({ behavior: 'smooth', block: 'start' });
+    }
+  });
+  document.querySelectorAll('.chip').forEach(chip => {
+    chip.addEventListener('click', () => {
+      const f = chip.dataset.filter;
+      if (state.filters.has(f)) { state.filters.delete(f); chip.classList.remove('active'); }
+      else { state.filters.add(f); chip.classList.add('active'); }
+      apply();
+    });
+  });
+  document.getElementById('expandAll').addEventListener('click', () => {
+    document.querySelectorAll('.part.tool, .part.reasoning').forEach(p => p.classList.add('open'));
+  });
+  document.getElementById('collapseAll').addEventListener('click', () => {
+    document.querySelectorAll('.part.tool, .part.reasoning').forEach(p => p.classList.remove('open'));
+  });
+  document.getElementById('toTop').addEventListener('click', () => {
+    document.getElementById('main').scrollTo({ top: 0, behavior: 'smooth' });
+  });
+  document.addEventListener('keydown', (e) => {
+    if (e.key === '/' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
+      e.preventDefault();
+      document.getElementById('q').focus();
+    }
+  });
+}
+
+renderHeader();
+renderOverview();
+fillToolSelect();
+bind();
+apply();
+</script>
+</body>
+</html>`;
+
+function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) =>
+    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
+  );
+}
+
+const outPath = join(DIR, 'analysis.html');
+writeFileSync(outPath, html, 'utf8');
+console.log(
+  JSON.stringify(
+    {
+      out: outPath,
+      mb: +(Buffer.byteLength(html) / 1024 / 1024).toFixed(2),
+      messages: payload.timeline.length,
+    },
+    null,
+    2,
+  ),
+);

diff --git a/round5/export-r9sf-session.mjs b/round5/export-r9sf-session.mjs
new file mode 100644
