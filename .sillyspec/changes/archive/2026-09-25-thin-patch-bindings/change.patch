+/**
+ * 导出 zcode 子会话全部内容（不做 UI 隐藏过滤、不做 200 段窗口截断）。
+ * 会话：R9-SF sess_subagent_agent_7d5faf40-f0bc-4066-9201-aa7eb3c61570
+ */
+import { createRequire } from 'node:module';
+import { writeFileSync, mkdirSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+
+const require = createRequire(import.meta.url);
+const { DatabaseSync } = require('node:sqlite');
+
+const SESS_ID = 'sess_subagent_agent_7d5faf40-f0bc-4066-9201-aa7eb3c61570';
+const OUT_DIR = join(
+  process.cwd(),
+  'round5',
+  'exports',
+  'R9-SF_sess_subagent_agent_7d5faf40-f0bc-4066-9201-aa7eb3c61570',
+);
+
+function parse(raw) {
+  if (raw == null) return null;
+  try {
+    return JSON.parse(raw);
+  } catch {
+    return { _raw: raw, _parseError: true };
+  }
+}
+
+function iso(ms) {
+  if (ms == null) return null;
+  return new Date(ms).toISOString();
+}
+
+function zh(ms) {
+  if (ms == null) return null;
+  return new Date(ms).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });
+}
+
+mkdirSync(OUT_DIR, { recursive: true });
+const db = new DatabaseSync(`${process.env.USERPROFILE}/.zcode/cli/db/db.sqlite`, {
+  readOnly: true,
+});
+
+const session = db.prepare('SELECT * FROM session WHERE id = ?').get(SESS_ID);
+if (!session) {
+  console.error('session not found:', SESS_ID);
+  process.exit(1);
+}
+
+const messages = db
+  .prepare(
+    `SELECT id, session_id, sequence, time_created, time_updated, data
+     FROM message WHERE session_id = ? ORDER BY sequence ASC`,
+  )
+  .all(SESS_ID);
+
+const parts = db
+  .prepare(
+    `SELECT id, message_id, session_id, sequence, time_created, time_updated, data
+     FROM part WHERE session_id = ? ORDER BY time_created ASC, sequence ASC`,
+  )
+  .all(SESS_ID);
+
+const partsByMsg = new Map();
+for (const p of parts) {
+  if (!partsByMsg.has(p.message_id)) partsByMsg.set(p.message_id, []);
+  partsByMsg.get(p.message_id).push(p);
+}
+
+const modelUsage = db
+  .prepare(`SELECT * FROM model_usage WHERE session_id = ? ORDER BY started_at ASC`)
+  .all(SESS_ID);
+
+const toolUsage = db
+  .prepare(`SELECT * FROM tool_usage WHERE session_id = ? ORDER BY started_at ASC`)
+  .all(SESS_ID);
+
+const turnUsage = db.prepare(`SELECT * FROM turn_usage WHERE session_id = ?`).all(SESS_ID);
+const todos = db.prepare(`SELECT * FROM todo WHERE session_id = ? ORDER BY position`).all(SESS_ID);
+const sessionEntries = db
+  .prepare(`SELECT * FROM session_entry WHERE session_id = ? ORDER BY time_created`)
+  .all(SESS_ID);
+const sessionInputs = db
+  .prepare(`SELECT * FROM session_input WHERE session_id = ? ORDER BY time_created`)
+  .all(SESS_ID);
+
+const timeline = messages.map((m) => {
+  const data = parse(m.data);
+  const mparts = (partsByMsg.get(m.id) || []).map((p) => ({
+    id: p.id,
+    sequence: p.sequence,
+    time_created: iso(p.time_created),
+    time_updated: iso(p.time_updated),
+    data: parse(p.data),
+  }));
+  return {
+    sequence: m.sequence,
+    id: m.id,
+    time_created: iso(m.time_created),
+    time_created_zh: zh(m.time_created),
+    time_updated: iso(m.time_updated),
+    message: data,
+    parts: mparts,
+  };
+});
+
+const full = {
+  exported_at: new Date().toISOString(),
+  exported_at_zh: new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' }),
+  source_db: `${process.env.USERPROFILE}\\.zcode\\cli\\db\\db.sqlite`,
+  session_id: SESS_ID,
+  parent_session_id: session.parent_id,
+  title: session.title,
+  session_meta: {
+    ...session,
+    time_created: iso(session.time_created),
+    time_updated: iso(session.time_updated),
+    time_created_zh: zh(session.time_created),
+    time_updated_zh: zh(session.time_updated),
+    duration_ms: session.time_updated - session.time_created,
+    permission: parse(session.permission),
+    revert: parse(session.revert),
+  },
+  counts: {
+    messages: messages.length,
+    parts: parts.length,
+    model_usage: modelUsage.length,
+    tool_usage: toolUsage.length,
+    turn_usage: turnUsage.length,
+    todos: todos.length,
+    session_entry: sessionEntries.length,
+    session_input: sessionInputs.length,
+  },
+  todos,
+  turn_usage: turnUsage,
+  session_input: sessionInputs.map((r) => ({
+    ...r,
+    payload: parse(r.payload),
+    time_created: iso(r.time_created),
+    time_updated: iso(r.time_updated),
+  })),
+  session_entry: sessionEntries.map((r) => ({
+    ...r,
+    data: parse(r.data),
+    time_created: iso(r.time_created),
+    time_updated: iso(r.time_updated),
+  })),
+  model_usage: modelUsage.map((r) => ({
+    ...r,
+    started_at: iso(r.started_at),
+    first_token_at: iso(r.first_token_at),
+    completed_at: iso(r.completed_at),
+    raw_usage: parse(r.raw_usage_json),
+    provider_metadata: parse(r.provider_metadata_json),
+  })),
+  tool_usage: toolUsage.map((r) => ({
+    ...r,
+    started_at: iso(r.started_at),
+    first_output_at: iso(r.first_output_at),
+    completed_at: iso(r.completed_at),
+  })),
+  timeline,
+};
+
+// 1) 完整 JSON
+const jsonPath = join(OUT_DIR, 'full.json');
+writeFileSync(jsonPath, JSON.stringify(full, null, 2), 'utf8');
+
+// 2) JSONL：每行一条 message（含 parts）
+const jsonlPath = join(OUT_DIR, 'messages.jsonl');
+writeFileSync(
+  jsonlPath,
+  timeline.map((t) => JSON.stringify(t)).join('\n') + '\n',
+  'utf8',
+);
+
+// 3) 人类可读 Markdown 时间线（含 tool 输入/输出全文）
+const mdLines = [];
+mdLines.push(`# R9-SF 子会话完整导出`);
+mdLines.push('');
+mdLines.push(`- session_id: \`${SESS_ID}\``);
+mdLines.push(`- parent_id: \`${session.parent_id}\``);
+mdLines.push(`- title: ${session.title}`);
+mdLines.push(`- directory: ${session.directory}`);
+mdLines.push(`- 起止: ${zh(session.time_created)} → ${zh(session.time_updated)}`);
+mdLines.push(
+  `- 时长: ${((session.time_updated - session.time_created) / 60000).toFixed(1)} min`,
+);
+mdLines.push(`- messages: ${messages.length} / parts: ${parts.length}`);
+mdLines.push(`- exported_at: ${full.exported_at_zh}`);
+mdLines.push('');
+mdLines.push(`## Todos`);
+mdLines.push('');
+for (const t of todos) {
+  mdLines.push(`- [${t.status}] ${t.content}`);
+}
+mdLines.push('');
+mdLines.push(`## Session Input（协调者注入）`);
+mdLines.push('');
+for (const si of full.session_input) {
+  mdLines.push('```');
+  mdLines.push(typeof si.payload?.text === 'string' ? si.payload.text : JSON.stringify(si.payload, null, 2));
+  mdLines.push('```');
+  mdLines.push('');
+}
+mdLines.push(`## 对话时间线`);
+mdLines.push('');
+
+for (const item of timeline) {
+  const role = item.message?.role || 'unknown';
+  const finish = item.message?.finish || '';
+  const model = item.message?.modelId || item.message?.model?.modelID || '';
+  mdLines.push(`### [#${item.sequence}] ${role}${finish ? ` · ${finish}` : ''}${model ? ` · ${model}` : ''}`);
+  mdLines.push('');
+  mdLines.push(`- id: \`${item.id}\``);
+  mdLines.push(`- time: ${item.time_created_zh} (\`${item.time_created}\`)`);
+  if (item.message?.semantics) {
+    mdLines.push(`- semantics: \`${JSON.stringify(item.message.semantics)}\``);
+  }
+  if (item.message?.synthetic) {
+    mdLines.push(`- synthetic: true / source=${item.message.source || ''}`);
+  }
+  mdLines.push('');
+
+  for (const p of item.parts) {
+    const d = p.data || {};
+    const type = d.type || 'unknown';
+    if (type === 'text') {
+      mdLines.push('#### text');
+      mdLines.push('');
+      mdLines.push('```');
+      mdLines.push(d.text ?? '');
+      mdLines.push('```');
+      mdLines.push('');
+    } else if (type === 'reasoning') {
+      mdLines.push('#### reasoning');
+      mdLines.push('');
+      mdLines.push('<details><summary>展开推理</summary>');
+      mdLines.push('');
+      mdLines.push('```');
+      mdLines.push(d.text ?? d.content ?? '');
+      mdLines.push('```');
+      mdLines.push('');
+      mdLines.push('</details>');
+      mdLines.push('');
+    } else if (type === 'tool') {
+      const name = d.tool || d.name || '?';
+      const st = d.state || {};
+      mdLines.push(`#### tool · ${name} · ${st.status || ''}`);
+      mdLines.push('');
+      if (st.title) mdLines.push(`- title: ${st.title}`);
+      mdLines.push('<details><summary>input</summary>');
+      mdLines.push('');
+      mdLines.push('```json');
+      mdLines.push(JSON.stringify(st.input ?? d.input ?? {}, null, 2));
+      mdLines.push('```');
+      mdLines.push('');
+      mdLines.push('</details>');
+      mdLines.push('');
+      if (st.output !== undefined || st.error !== undefined) {
+        mdLines.push('<details><summary>output / error</summary>');
+        mdLines.push('');
+        mdLines.push('```');
+        const out =
+          st.error !== undefined
+            ? typeof st.error === 'string'
+              ? st.error
+              : JSON.stringify(st.error, null, 2)
+            : typeof st.output === 'string'
+              ? st.output
+              : JSON.stringify(st.output, null, 2);
+        mdLines.push(out ?? '');
+        mdLines.push('```');
+        mdLines.push('');
+        mdLines.push('</details>');
+        mdLines.push('');
+      }
+    } else if (type === 'step-start' || type === 'step-finish' || type === 'timeline') {
+      mdLines.push(`#### ${type}`);
+      mdLines.push('');
+      mdLines.push('```json');
+      mdLines.push(JSON.stringify(d, null, 2));
+      mdLines.push('```');
+      mdLines.push('');
+    } else {
+      mdLines.push(`#### ${type}`);
+      mdLines.push('');
+      mdLines.push('```json');
+      mdLines.push(JSON.stringify(d, null, 2));
+      mdLines.push('```');
+      mdLines.push('');
+    }
+  }
+  mdLines.push('---');
+  mdLines.push('');
+}
+
+const mdPath = join(OUT_DIR, 'transcript.md');
+writeFileSync(mdPath, mdLines.join('\n'), 'utf8');
+
+// 4) 索引 README
+const readme = `# R9-SF 子会话导出包
+
+- session_id: \`${SESS_ID}\`
+- parent: \`${session.parent_id}\`
+- title: ${session.title}
+- 导出时间: ${full.exported_at_zh}
+
+## 文件
+
+| 文件 | 说明 |
+|---|---|
+| \`full.json\` | 全量结构化导出（session + timeline + usage + todos + session_input/entry） |
+| \`messages.jsonl\` | 每行一条 message（含 parts），便于流式处理 |
+| \`transcript.md\` | 人类可读完整时间线（含 tool input/output、reasoning） |
+| \`README.md\` | 本说明 |
+
+## 计数
+
+${JSON.stringify(full.counts, null, 2)}
+`;
+writeFileSync(join(OUT_DIR, 'README.md'), readme, 'utf8');
+
+const sizes = {
+  full_json_mb: (Buffer.byteLength(JSON.stringify(full)) / 1024 / 1024).toFixed(2),
+  transcript_md_mb: (Buffer.byteLength(mdLines.join('\n')) / 1024 / 1024).toFixed(2),
+};
+
+console.log(JSON.stringify({ out_dir: OUT_DIR, counts: full.counts, sizes }, null, 2));
+db.close();

