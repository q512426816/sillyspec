+  .filters input, .filters select {
+    width: 100%;
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    padding: 8px 10px;
+    font: inherit;
+    font-size: .85rem;
+    background: var(--bg-elev);
+    color: var(--ink);
+  }
+  .filters input:focus, .filters select:focus {
+    outline: 2px solid color-mix(in srgb, var(--accent) 40%, transparent);
+    border-color: var(--accent);
+  }
+  .chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
+  .chip {
+    border: 1px solid var(--line);
+    background: var(--bg-elev);
+    border-radius: 999px;
+    padding: 3px 9px;
+    font-size: .75rem;
+    cursor: pointer;
+    color: var(--muted);
+  }
+  .chip.active {
+    background: var(--accent);
+    border-color: var(--accent);
+    color: #fff;
+  }
+  .nav-list {
+    overflow: auto;
+    flex: 1;
+    padding: 8px;
+  }
+  .nav-item {
+    display: grid;
+    grid-template-columns: 44px 1fr;
+    gap: 8px;
+    padding: 8px;
+    border-radius: 8px;
+    cursor: pointer;
+    border: 1px solid transparent;
+    margin-bottom: 2px;
+  }
+  .nav-item:hover { background: #00000006; }
+  .nav-item.active {
+    background: var(--accent-soft);
+    border-color: #99f6e4;
+  }
+  .nav-item .seq {
+    font-family: var(--mono);
+    font-size: .72rem;
+    color: var(--muted);
+    padding-top: 2px;
+  }
+  .nav-item .meta { min-width: 0; }
+  .nav-item .role {
+    font-size: .78rem;
+    font-weight: 650;
+  }
+  .nav-item .role.user { color: var(--user); }
+  .nav-item .role.assistant { color: var(--asst); }
+  .nav-item .preview {
+    font-size: .72rem;
+    color: var(--muted);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+  .nav-item .tags { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 3px; }
+  .tag {
+    font-size: .65rem;
+    padding: 1px 5px;
+    border-radius: 4px;
+    background: #00000008;
+    color: var(--muted);
+  }
+  .tag.tool { background: var(--tool-soft); color: var(--tool); }
+  .tag.err { background: var(--err-soft); color: var(--err); }
+  .tag.syn { background: #f5f5f4; }
+  .tag.bash-silly { background: #dbeafe; color: #1d4ed8; }
+  .tag.bash-test { background: #ffedd5; color: #c2410c; }
+  .tag.bash-other { background: #e7e5e4; color: #44403c; }
+  .pill.bash-silly { background: #dbeafe; color: #1d4ed8; }
+  .pill.bash-test { background: #ffedd5; color: #c2410c; }
+  .pill.bash-other { background: #e7e5e4; color: #44403c; }
+  .part.tool.bash-silly { border-color: #93c5fd; }
+  .part.tool.bash-test { border-color: #fdba74; }
+  .part.tool.bash-other { border-color: #d6d3d1; }
+  .stage-tabs {
+    display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px;
+  }
+  .stage-tab {
+    border: 1px solid var(--line);
+    background: var(--bg-elev);
+    border-radius: 8px;
+    padding: 6px 10px;
+    font-size: .78rem;
+    cursor: pointer;
+    color: var(--muted);
+    text-align: left;
+  }
+  .stage-tab:hover { border-color: var(--accent); color: var(--ink); }
+  .stage-tab.active {
+    background: var(--accent);
+    border-color: var(--accent);
+    color: #fff;
+  }
+  .stage-tab b { display: block; color: inherit; font-size: .85rem; }
+  .stage-tab .meta { opacity: .85; font-size: .68rem; margin-top: 2px; }
+  .stage-tab.active .meta { opacity: .9; }
+  .stage-banner {
+    position: sticky;
+    top: 0;
+    z-index: 5;
+    margin: 18px 0 12px;
+    padding: 12px 14px;
+    border-radius: var(--radius);
+    border: 1px solid var(--line);
+    background: linear-gradient(90deg, #0f766e 0%, #134e4a 100%);
+    color: #ecfdf5;
+    box-shadow: var(--shadow);
+    scroll-margin-top: 80px;
+  }
+  .stage-banner.plan { background: linear-gradient(90deg, #1d4ed8 0%, #1e3a8a 100%); color: #eff6ff; }
+  .stage-banner.setup { background: linear-gradient(90deg, #57534e 0%, #292524 100%); color: #fafaf9; }
+  .stage-banner.execute { background: linear-gradient(90deg, #a16207 0%, #713f12 100%); color: #fffbeb; }
+  .stage-banner.verify { background: linear-gradient(90deg, #c2410c 0%, #7c2d12 100%); color: #fff7ed; }
+  .stage-banner.archive { background: linear-gradient(90deg, #6d28d9 0%, #4c1d95 100%); color: #f5f3ff; }
+  .stage-banner.wrapup { background: linear-gradient(90deg, #0e7490 0%, #155e75 100%); color: #ecfeff; }
+  .stage-banner h3 { margin: 0 0 4px; font-size: 1rem; }
+  .stage-banner .sub { font-size: .75rem; opacity: .9; display: flex; flex-wrap: wrap; gap: 8px 14px; }
+  .nav-stage-label {
+    font-size: .68rem;
+    font-weight: 700;
+    color: var(--muted);
+    padding: 8px 8px 4px;
+    text-transform: none;
+    letter-spacing: .02em;
+  }
+  .bash-legend {
+    display: flex; flex-wrap: wrap; gap: 8px; font-size: .78rem; margin-top: 6px;
+  }
+  .bash-legend span {
+    display: inline-flex; align-items: center; gap: 5px;
+    padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line);
+  }
+
+  main {
+    overflow: auto;
+    padding: 16px 20px 48px;
+  }
+  .panel {
+    background: var(--bg-elev);
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    box-shadow: var(--shadow);
+    padding: 14px 16px;
+    margin-bottom: 14px;
+  }
+  .panel h2 {
+    margin: 0 0 10px;
+    font-size: .95rem;
+    letter-spacing: -0.01em;
+  }
+  .grid-2 {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 12px;
+  }
+  @media (max-width: 1100px) {
+    .app { grid-template-columns: 1fr; grid-template-rows: auto auto 1fr; }
+    aside { max-height: 280px; border-right: 0; border-bottom: 1px solid var(--line); }
+    .grid-2 { grid-template-columns: 1fr; }
+  }
+  table.mini {
+    width: 100%;
+    border-collapse: collapse;
+    font-size: .8rem;
+  }
+  table.mini th, table.mini td {
+    text-align: left;
+    padding: 5px 6px;
+    border-bottom: 1px solid var(--line);
+  }
+  table.mini th { color: var(--muted); font-weight: 600; }
+  pre.block, .text-body {
+    white-space: pre-wrap;
+    word-break: break-word;
+    font-family: var(--mono);
+    font-size: .78rem;
+    background: #1c191308;
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    padding: 10px 12px;
+    margin: 0;
+    max-height: 420px;
+    overflow: auto;
+  }
+  .text-body.prose {
+    font-family: var(--sans);
+    font-size: .9rem;
+    line-height: 1.65;
+    background: transparent;
+    border: 0;
+    padding: 0;
+    max-height: none;
+  }
+  .msg {
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    background: var(--bg-elev);
+    box-shadow: var(--shadow);
+    margin-bottom: 14px;
+    overflow: hidden;
+    scroll-margin-top: 90px;
+  }
+  .msg.hidden-by-filter { display: none; }
+  .stage-banner.hidden-by-filter { display: none; }
+  .msg-head {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px 12px;
+    align-items: center;
+    padding: 10px 14px;
+    border-bottom: 1px solid var(--line);
+    background: linear-gradient(180deg, #fff 0%, #faf7f2 100%);
+  }
+  .msg.user .msg-head { background: linear-gradient(180deg, #eff6ff 0%, #dbeafe55 100%); }
+  .msg.assistant .msg-head { background: linear-gradient(180deg, #f0fdfa 0%, #ccfbf155 100%); }
+  .badge {
+    font-size: .72rem;
+    font-weight: 700;
+    padding: 2px 8px;
+    border-radius: 999px;
+    letter-spacing: .02em;
+  }
+  .badge.user { background: var(--user); color: #fff; }
+  .badge.assistant { background: var(--asst); color: #fff; }
+  .badge.unknown { background: #57534e; color: #fff; }
+  .msg-head .time { color: var(--muted); font-size: .75rem; font-family: var(--mono); }
+  .msg-head .id { color: var(--muted); font-size: .68rem; font-family: var(--mono); }
+  .msg-body { padding: 12px 14px; display: grid; gap: 10px; }
+  .part {
+    border: 1px solid var(--line);
+    border-radius: 8px;
+    overflow: hidden;
+  }
+  .part-h {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding: 7px 10px;
+    background: #00000004;
+    font-size: .78rem;
+    font-weight: 650;
+    cursor: pointer;
+    user-select: none;
+  }
+  .part-h .pill {
+    font-weight: 600;
+    font-size: .68rem;
+    padding: 1px 6px;
+    border-radius: 4px;
+  }
+  .part.text .pill { background: var(--user-soft); color: var(--user); }
+  .part.reasoning .pill { background: #ede9fe; color: #5b21b6; }
+  .part.tool .pill { background: var(--tool-soft); color: var(--tool); }
+  .part.tool.error .pill, .part.tool .pill.err { background: var(--err-soft); color: var(--err); }
+  .part-b { padding: 10px; border-top: 1px solid var(--line); display: none; }
+  .part.open .part-b { display: block; }
+  .part.text.open .part-b, .part.text .part-b { display: block; }
+  .part.text .part-h { cursor: default; }
+  .toolbar-float {
+    position: fixed;
+    right: 18px;
+    bottom: 18px;
+    display: flex;
+    gap: 8px;
+    z-index: 30;
+  }
+  .toolbar-float button {
+    border: 1px solid var(--line);
+    background: var(--bg-elev);
+    border-radius: 999px;
+    padding: 8px 12px;
+    font: inherit;
+    font-size: .8rem;
+    cursor: pointer;
+    box-shadow: var(--shadow);
+  }
+  .toolbar-float button:hover { border-color: var(--accent); color: var(--accent); }
+  .empty {
+    color: var(--muted);
+    text-align: center;
+    padding: 40px 12px;
+  }
+  .kbd {
+    font-family: var(--mono);
+    font-size: .7rem;
+    border: 1px solid var(--line);
+    border-bottom-width: 2px;
+    border-radius: 4px;
+    padding: 0 5px;
+    background: #fff;
+  }
+</style>
+</head>
+<body>
+<div class="app">
+  <header class="top">
+    <h1 id="title">R9-SF 会话分析</h1>
+    <div class="sub" id="submeta"></div>
+    <div class="stats" id="stats"></div>
+    <div class="stage-tabs" id="stageTabs"></div>
+  </header>
+
+  <aside>
+    <div class="filters">
+      <input id="q" type="search" placeholder="搜索文本 / 工具名 / seq…" />
+      <select id="role">
+        <option value="all">全部角色</option>
+        <option value="user">仅 user</option>
+        <option value="assistant">仅 assistant</option>
+      </select>
+      <select id="tool">
+        <option value="all">全部工具</option>
+      </select>
+      <select id="bashKind">
+        <option value="all">Bash 分类：全部</option>
+        <option value="sillyspec">Bash · sillyspec CLI</option>
+        <option value="test">Bash · 测试/门禁</option>
+        <option value="other">Bash · 其它</option>
+      </select>
+      <select id="stage">
+        <option value="all">阶段：全部</option>
+      </select>
+      <div class="chip-row">
+        <button type="button" class="chip" data-filter="errors">仅错误</button>
+        <button type="button" class="chip" data-filter="tools">含工具</button>
+        <button type="button" class="chip" data-filter="bashSilly">含 sillyspec</button>
+        <button type="button" class="chip" data-filter="bashTest">含测试调用</button>
+        <button type="button" class="chip" data-filter="text">含回复文本</button>
+        <button type="button" class="chip" data-filter="human">人工/协调者</button>
+        <button type="button" class="chip active" data-filter="hideSyn">隐藏系统通知</button>
+      </div>
+      <div style="font-size:.72rem;color:var(--muted)">匹配 <b id="matchCount">0</b> / <span id="totalCount">0</span> · <span class="kbd">/</span> 聚焦搜索</div>
+    </div>
+    <div class="nav-list" id="nav"></div>
+  </aside>
+
+  <main id="main">
+    <div class="grid-2" id="overview"></div>
+    <div id="feed"></div>
+  </main>
+</div>
+
+<div class="toolbar-float">
+  <button type="button" id="expandAll">展开全部工具</button>
+  <button type="button" id="collapseAll">折叠工具/推理</button>
+  <button type="button" id="toTop">回顶</button>
+</div>
+
+<script id="DATA" type="application/json">${json}</script>
+<script>
+const DATA = JSON.parse(document.getElementById('DATA').textContent);
+const STAGE_LABEL = {
+  setup: '环境准备',
+  brainstorm: '头脑风暴',
+  plan: '计划',
+  execute: '执行',
+  verify: '验证',
+  archive: '归档',
+  wrapup: '收尾/报告',
+};
+const state = {
+  q: '',
+  role: 'all',
+  tool: 'all',
+  bashKind: 'all',
+  stage: 'all',
+  filters: new Set(['hideSyn']),
+};
+
+const BASH_KIND_LABEL = {
+  sillyspec: 'sillyspec CLI',
+  test: '测试/门禁',
+  other: '其它 shell',
+};
+
+function fmtNum(n) {
+  if (n == null) return '—';
+  if (n >= 1e6) return (n/1e6).toFixed(2) + 'M';
+  if (n >= 1e3) return (n/1e3).toFixed(1) + 'k';
+  return String(n);
+}
+function esc(s) {
+  return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+}
+function previewOf(m) {
+  for (const p of m.parts) {
+    if (p.type === 'text' && p.text) return p.text.replace(/\\s+/g, ' ').slice(0, 80);
+    if (p.type === 'tool' && p.name === 'Bash' && p.bash_kind) {
+      const label = BASH_KIND_LABEL[p.bash_kind] || p.bash_kind;
+      const cmd = (p.command || '').replace(/\\s+/g, ' ').slice(0, 70);
+      return 'Bash/' + label + (cmd ? ' · ' + cmd : '');
+    }
+    if (p.type === 'tool') return '⚙ ' + p.name + (p.title ? ' · ' + p.title : '');
+  }
+  if (m.synthetic) return '(系统/后台通知)';
+  return '(无正文)';
+}
+function toolsOf(m) {
+  return m.parts.filter(p => p.type === 'tool').map(p => p.name);
+}
+function bashKindsOf(m) {
+  return m.parts.filter(p => p.type === 'tool' && p.name === 'Bash' && p.bash_kind).map(p => p.bash_kind);
+}
+function hasError(m) {
+  return m.parts.some(p => p.type === 'tool' && (p.status === 'error' || p.error));
+}
+function isHumanish(m) {
+  if (m.role !== 'user') return false;
+  if (m.synthetic) return false;
+  if (m.semantics?.origin === 'real_user') return true;
+  return !m.synthetic;
+}
+function matches(m) {
+  if (state.role !== 'all' && m.role !== state.role) return false;
+  if (state.tool !== 'all' && !toolsOf(m).includes(state.tool)) return false;
+  if (state.bashKind !== 'all' && !bashKindsOf(m).includes(state.bashKind)) return false;
+  if (state.stage !== 'all' && m.stage !== state.stage) return false;
+  if (state.filters.has('errors') && !hasError(m)) return false;
+  if (state.filters.has('tools') && toolsOf(m).length === 0) return false;
+  if (state.filters.has('bashSilly') && !bashKindsOf(m).includes('sillyspec')) return false;
+  if (state.filters.has('bashTest') && !bashKindsOf(m).includes('test')) return false;
+  if (state.filters.has('text') && !m.parts.some(p => p.type === 'text' && p.text)) return false;
+  if (state.filters.has('human') && !isHumanish(m)) return false;
+  if (state.filters.has('hideSyn') && m.synthetic) return false;
+  const q = state.q.trim().toLowerCase();
+  if (!q) return true;
+  if (String(m.seq) === q || String(m.seq).includes(q)) return true;
+  if ((m.id || '').toLowerCase().includes(q)) return true;
+  for (const p of m.parts) {
+    if (p.type === 'text' && (p.text || '').toLowerCase().includes(q)) return true;
+    if (p.type === 'reasoning' && (p.text || '').toLowerCase().includes(q)) return true;
+    if (p.type === 'tool') {
+      if ((p.name || '').toLowerCase().includes(q)) return true;
+      if ((p.title || '').toLowerCase().includes(q)) return true;
+      if ((p.bash_kind || '').toLowerCase().includes(q)) return true;
+      if ((p.command || '').toLowerCase().includes(q)) return true;
+      const blob = JSON.stringify(p.input || '') + JSON.stringify(p.output || '') + JSON.stringify(p.error || '');
+      if (blob.toLowerCase().includes(q)) return true;
+    }
+  }
+  return false;
+}
+
+function renderHeader() {
+  const m = DATA.meta;
+  document.getElementById('title').textContent = m.title || 'R9-SF 会话分析';
+  document.getElementById('submeta').innerHTML = [
+    '<span>session <code>' + esc(m.session_id) + '</code></span>',
+    '<span>parent <code>' + esc(m.parent_session_id) + '</code></span>',
+    '<span>' + esc(m.time_created_zh) + ' → ' + esc(m.time_updated_zh) + '</span>',
+    '<span>墙钟 <b>' + esc(m.duration_min) + ' min</b></span>',
+    '<span>' + esc(m.directory) + '</span>',
+  ].join('');
+  const u = DATA.model_usage_summary;
+  const t = DATA.tool_usage_summary;
+  const bk = DATA.bash_kind_summary || {};
+  const stats = [
+    ['消息', m.counts.messages],
+    ['模型请求', u.n],
+    ['Input', fmtNum(u.input)],
+    ['Cache命中', u.cache_pct + '%'],
+    ['Bash', (bk.sillyspec||0) + (bk.test||0) + (bk.other||0)],
+    ['↳ sillyspec', bk.sillyspec || 0],
+    ['↳ 测试', bk.test || 0],
+    ['↳ 其它', bk.other || 0],
+    ['工具错误', t.err],
+  ];
+  document.getElementById('stats').innerHTML = stats.map(([k,v]) => {
+    let cls = 'stat';
+    if (k === '工具错误' && v > 0) cls = 'stat warn';
+    if (k === '↳ sillyspec') cls = 'stat ok';
+    if (k === '↳ 测试') cls = 'stat warn';
+    return '<span class="' + cls + '">' + k + ' <b>' + esc(v) + '</b></span>';
+  }).join('');
+  renderStageTabs();
+}
+
+function renderStageTabs() {
+  const tabs = document.getElementById('stageTabs');
+  const rows = DATA.stage_summary || [];
+  const allBtn =
+    '<button type="button" class="stage-tab' + (state.stage === 'all' ? ' active' : '') + '" data-stage="all">' +
+    '<b>全部阶段</b><div class="meta">' + DATA.timeline.length + ' 条消息</div></button>';
+  tabs.innerHTML = allBtn + rows.map(s => {
+    const active = state.stage === s.id ? ' active' : '';
+    return '<button type="button" class="stage-tab' + active + '" data-stage="' + esc(s.id) + '">' +
+      '<b>' + esc(s.label) + '</b>' +
+      '<div class="meta">#' + s.seq_from + '–' + s.seq_to + ' · ' + s.messages + ' 条 · Bash ' +
+      ((s.bash.sillyspec||0)+(s.bash.test||0)+(s.bash.other||0)) + '</div></button>';
+  }).join('');
+  tabs.querySelectorAll('.stage-tab').forEach(btn => {
+    btn.addEventListener('click', () => {
+      state.stage = btn.getAttribute('data-stage');
+      document.getElementById('stage').value = state.stage;
+      apply();
+      if (state.stage !== 'all') {
+        const banner = document.getElementById('stage-banner-' + state.stage);
+        if (banner) banner.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      } else {
+        document.getElementById('main').scrollTo({ top: 0, behavior: 'smooth' });
+      }
+    });
+  });
+}
+
+function renderOverview() {
+  const u = DATA.model_usage_summary;
+  const t = DATA.tool_usage_summary;
+  const bk = DATA.bash_kind_summary || { sillyspec: 0, test: 0, other: 0 };
+  const bashTotal = (bk.sillyspec||0) + (bk.test||0) + (bk.other||0);
+  const stageRows = (DATA.stage_summary || []).map(s =>
+    '<tr><td><b>' + esc(s.label) + '</b></td><td>#' + s.seq_from + '–' + s.seq_to + '</td><td>' +
+    esc(s.time_from) + ' → ' + esc(s.time_to) + '</td><td>' + s.messages + '</td><td>' + s.tools +
+    '</td><td>' + (s.bash.sillyspec||0) + ' / ' + (s.bash.test||0) + ' / ' + (s.bash.other||0) + '</td></tr>'
+  ).join('');
+  const toolRows = Object.entries(t.by).sort((a,b)=>b[1]-a[1])
+    .map(([k,v]) => '<tr><td>' + esc(k) + '</td><td>' + v + '</td></tr>').join('');
+  const todos = (DATA.todos || []).map(td =>
