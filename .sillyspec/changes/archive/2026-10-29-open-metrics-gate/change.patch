+  assert.ok(book.includes('根因判据') && book.includes('guard'), '检查单含根因判据（guard 掩盖≠修复）')
+  assert.ok(/6\./.test(book), '判据为编号检查项（可逐条作答）')
+})
diff --git a/test/quick-metrics-gate.test.mjs b/test/quick-metrics-gate.test.mjs
