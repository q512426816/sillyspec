+/** --input 语料中的路径样 token 提取（fresh 起点的域路由依据——best-effort：无 design/diff 时
+ * 唯一可判材料；提取失败=空数组，走空域诚实提示）。 */
+function extractInputPaths(input) {
+  const out = new Set()
+  for (const m of String(input || '').matchAll(/[\w.@+-]+(?:\/[\w.@+-]+)+/g)) {
+    const p = m[0].replace(/\/+$/, '')
+    if (p.length > 1) out.add(p.replace(/\\/g, '/'))
+  }
+  return [...out]
+}
