+              if (inOwnCommit && !/^[0-9a-f]{7,40}$/.test(t)) files.push(t)
+            }
+            if (files.length > 0) {
+              commitWindowFiles = files
+              sources.push('main:log-msg-window(declared-rescue-only:HEAD)')
+            }
+          }
+        } catch { /* 消息窗口失败静默省略（不干扰主链） */ }
