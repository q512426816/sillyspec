+    assert.ok(sups.some((e) => e.s === 'decision:decisions/core.md#D-002@v2'
+      && e.t === 'decision:decisions/core.md#D-002@v1'), '双 legacy（双方无变更行）同源建边')
+    assert.ok(!sups.some((e) => e.s === 'decision:decisions/core.md#D-004@v1@2026-01-07-x'),
