+/** design.md 章节行号索引（execute.js:1011 先例）：`L<行> ## <节名>` 全列。 */
+function sectionIndexLines(designContent) {
+  const out = []
+  String(designContent || '').split('\n').forEach((l, i) => {
+    const m = l.match(/^##\s+(.+)$/)
+    if (m) out.push(`L${i + 1} ## ${m[1].trim()}`)
+  })
+  return out
