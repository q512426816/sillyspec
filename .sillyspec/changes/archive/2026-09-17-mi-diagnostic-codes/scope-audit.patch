+// ─────────────────────────────────────────
+// 11. codes 键加法式行为（2026-09-17-mi-diagnostic-codes）
+// 深度断言在 test/diagnostic-codes-parity.test.mjs；此处钉「不破坏既有信封预期 + 基本在场」
+// ─────────────────────────────────────────
+console.log('--- 11. codes 键加法式行为 ---')
+{
+  const f = await makeProjectFixture({ changeName: 'codes-k1' })
