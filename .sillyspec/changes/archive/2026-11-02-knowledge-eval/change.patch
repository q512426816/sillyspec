diff --git a/eval/knowledge/lib/dataset.mjs b/eval/knowledge/lib/dataset.mjs
new file mode 100644
index 00000000..871b57a0
--- /dev/null
+++ b/eval/knowledge/lib/dataset.mjs
@@ -0,0 +1,124 @@
+/**
+ * eval/knowledge/lib/dataset.mjs — 三源数据集加载/校验/现场构建
+ *
+ * organic：提交冻结的 JSONL（遥测 query 抽样 + 人工 anchor 级标签），加载即校验。
+ * self：现场从归档 flow-state.input 构建，期望集 = 该变更蒸馏出的决策（按 变更+id/原编号 映射），
+ *       仅用于「蒸馏→检索链路」smoke，禁止进质量指标（自产自测偏差，design 已论证）。
+ * probes：fixtures 目录枚举（每个子目录一个缺陷探针，runner 负责执行）。
+ */
+import { existsSync, readFileSync, readdirSync } from 'node:fs'
+import { join } from 'node:path'
+import { parseDecisionEntries } from '../../../src/knowledge-match.js'
+import { readFlowState } from '../../../src/flow-state.js'
+
+const FACES = new Set(['entries', 'decisions', 'search', 'scope'])
+const REPOS = new Set(['sillyspec', 'platform'])
+
+/** organic case 字段校验；返回 null = 合法，否则错误原因。 */
+export function validateOrganicCase(c) {
+  if (!c || typeof c !== 'object' || Array.isArray(c)) return 'not-object'
+  if (!c.id || typeof c.id !== 'string') return 'id'
+  if (!REPOS.has(c.repo)) return 'repo'
+  if (!FACES.has(c.face)) return 'face'
+  if (!c.query || typeof c.query !== 'string' || !c.query.trim()) return 'query'
+  if (!Array.isArray(c.expected) || c.expected.length === 0) return 'expected-empty'
+  if (c.expected.some((e) => typeof e !== 'string' || !e.trim())) return 'expected-item'
+  return null
+}
+
+/**
+ * 加载 organic JSONL：空行/`//` 注释跳过；坏 JSON、字段缺失、expected 空 → skipped（禁止静默当零命中）。
+ * @returns {{cases: Array, skipped: Array<{line:number, reason:string, id?:string}>, missing: boolean}}
+ */
+export function loadOrganic(filePath) {
+  const cases = []
+  const skipped = []
+  if (!existsSync(filePath)) return { cases, skipped, missing: true }
+  const lines = readFileSync(filePath, 'utf8').split('\n')
+  lines.forEach((raw, i) => {
+    const line = raw.trim()
+    if (!line || line.startsWith('//')) return
+    let c
+    try { c = JSON.parse(line) } catch { skipped.push({ line: i + 1, reason: 'bad-json' }); return }
+    const err = validateOrganicCase(c)
+    if (err) { skipped.push({ line: i + 1, reason: err, id: c && c.id }); return }
+    cases.push({ source: 'organic', ...c })
+  })
+  return { cases, skipped, missing: false }
+}
+
+/**
+ * 现场构建 self 集：归档 flow-state.input → 该变更蒸馏决策的映射（变更+id 或 变更+原编号）。
+ * 映射不到任何决策的归档 → skipped（无期望集可测，不造 case）。
+ * @returns {{cases: Array, skipped: Array<{archive:string, reason:string}>}}
+ */
+export function buildSelfCases(repoRoot, repo) {
+  const archive = join(repoRoot, '.sillyspec', 'changes', 'archive')
+  const knowledgeDir = join(repoRoot, '.sillyspec', 'knowledge')
+  const cases = []
+  const skipped = []
+  if (!existsSync(archive)) return { cases, skipped }
+  const decisions = parseDecisionEntries(knowledgeDir)
+  for (const name of readdirSync(archive).sort()) {
+    const dir = join(archive, name)
+    const st = readFlowState(dir)
+    if (!st || !st.input || typeof st.input !== 'string' || !st.input.trim()) {
+      skipped.push({ archive: name, reason: 'no-input' })
+      continue
+    }
+    const dmd = join(dir, 'decisions.md')
+    if (!existsSync(dmd)) { skipped.push({ archive: name, reason: 'no-decisions-md' }); continue }
+    const localIds = [...readFileSync(dmd, 'utf8').matchAll(/^##\s+(D-(?:[A-Za-z0-9_-]+-)?\d+@v\d+)/gm)].map((m) => m[1])
+    const own = []
+    for (const id of localIds) {
+      const hit = decisions.find((h) => h.change === name && (h.id === id || h.originId === id))
+      if (hit) own.push(`${hit.file}#${hit.id}`)
+    }
+    if (own.length === 0) { skipped.push({ archive: name, reason: 'no-mapped-decision' }); continue }
+    cases.push({
+      source: 'self', id: `self-${name}`, repo, face: 'self',
+      query: st.input.trim(), expected: [...new Set(own)], own: [...new Set(own)],
+    })
+  }
+  return { cases, skipped }
+}
+
+/**
+ * 遥测 inject 事件 → organic 候选池（去重 change+query，单变更限流）。
+ * @returns {Array<{change:string, query:string}>}
+ */
+export function extractTelemetryPool(telemetryPath, { limitPerChange = 3 } = {}) {
+  if (!existsSync(telemetryPath)) return []
+  const seen = new Set()
+  const byChange = new Map()
+  for (const line of readFileSync(telemetryPath, 'utf8').split('\n')) {
+    const t = line.trim()
+    if (!t) continue
+    let r
+    try { r = JSON.parse(t) } catch { continue }
+    if (!r || r.type !== 'inject' || typeof r.query !== 'string' || typeof r.change !== 'string') continue
+    const q = r.query.replace(/\r\n/g, '\n').trim()
+    if (!q) continue
+    const key = `${r.change}\u0000${q}`
+    if (seen.has(key)) continue
+    seen.add(key)
+    const arr = byChange.get(r.change) || []
+    if (arr.length < limitPerChange) arr.push(q)
+    byChange.set(r.change, arr)
+  }
+  const out = []
+  for (const [change, queries] of byChange) for (const q of queries) out.push({ change, query: q })
+  return out
+}
+
+/** 枚举探针 fixture 目录（每子目录一个；无目录 = 空数组）。 */
+export function listProbes(fixturesDir) {
+  try {
+    return readdirSync(fixturesDir, { withFileTypes: true })
+      .filter((d) => d.isDirectory())
+      .map((d) => d.name)
+      .sort()
+  } catch {
+    return []
+  }
+}
diff --git a/eval/knowledge/lib/engine.mjs b/eval/knowledge/lib/engine.mjs
new file mode 100644
index 00000000..d3ab2e46
--- /dev/null
+++ b/eval/knowledge/lib/engine.mjs
@@ -0,0 +1,77 @@
+/**
+ * eval/knowledge/lib/engine.mjs — 只读适配 src 检索引擎（评测面）
+ *
+ * 统一命中键：entries/search/scope-entry = `file#anchor`（anchor 缺省为 file）；
+ * decisions/scope-decision = `file#id`。期望侧不含 "#" 时按文件级前缀匹配（runner 展开）。
+ *
+ * searchView 镜像 src/stages/knowledge.js cmdSearch 的构造（score = entry.keywords.length，
+ * 2026-11-02 现状事实）——score 契约探针测的正是这处消费面；变更 1 修 score 时两处同步改。
+ *
+ * 零网络零遥测：只调纯读函数；图构建的缓存写向 <specRoot>/.runtime/cache（可再生派生，
+ * fixture 场景落在 mkdtemp 内，真实仓场景仅缓存，不触测试/遥测面）。
+ */
+import { join } from 'node:path'
+import { existsSync } from 'node:fs'
+import { matchByRouting, parseDecisionEntries, keywordMatchesContext } from '../../../src/knowledge-match.js'
+import { buildKnowledgeGraph, scopeRecall } from '../../../src/knowledge-graph.js'
+
+const graphCache = new Map()
+
+function specRootOf(repoRoot) { return join(repoRoot, '.sillyspec') }
+function knowledgeDirOf(repoRoot) { return join(specRootOf(repoRoot), 'knowledge') }
+
+function entryKey(e) { return e.anchor ? `${e.file}#${e.anchor}` : e.file }
+
+/** entries 面：路由命中的面向人条目（当前实现含 fr/decisions 路由行——探针③的检测对象）。 */
+export function runEntries(repoRoot, query) {
+  const r = matchByRouting(knowledgeDirOf(repoRoot), query)
+  return { matched: r.matched, hits: r.entries.map(entryKey), raw: r.entries }
+}
+
+/** decisions 面：rejected/死路优先的决策命中通道。 */
+export function runDecisions(repoRoot, query) {
+  const r = matchByRouting(knowledgeDirOf(repoRoot), query)
+  return { hits: (r.decisionHits || []).map((h) => `${h.file}#${h.id}`), raw: r.decisionHits || [] }
+}
+
+/** search 面（镜像 cmdSearch）：file 级行 + 当前 score 契约（keywords.length）+ 实际命中标签。 */
+export function searchView(repoRoot, query, limit = 10) {
+  const r = matchByRouting(knowledgeDirOf(repoRoot), query)
+  const ctx = String(query || '').toLowerCase()
+  return r.entries.slice(0, limit).map((e) => ({
+    file: e.file,
+    anchor: e.anchor,
+    score: e.keywords.length,
+    tags: e.keywords,
+    matchedTags: e.keywords.filter((k) => keywordMatchesContext(k, ctx)),
+  }))
+}
+
+/** scope 面：图遍历召回（entryHits 前 3 合成 entries + decisionHits 前 20）。 */
+export function runScope(repoRoot, scopeFiles) {
+  const root = specRootOf(repoRoot)
+  if (!graphCache.has(root)) graphCache.set(root, buildKnowledgeGraph(root))
+  const recall = scopeRecall(graphCache.get(root), scopeFiles || [])
+  if (!recall) return { entryHits: [], decisionHits: [], merged: [] }
+  const entryHits = recall.entries.map(entryKey)
+  const decisionHits = recall.decisionHits.map((h) => `${h.file}#${h.id}`)
+  return { entryHits, decisionHits, merged: [...entryHits.slice(0, 3), ...decisionHits.slice(0, 20)] }
+}
+
+/** 语料健康：决策条目总数 / 有锚点 / 有文件字段 / 任一关联（linkage 探针与 baseline 用）。 */
+export function catalogHealth(repoRoot) {
+  const kdir = knowledgeDirOf(repoRoot)
+  if (!existsSync(join(kdir, 'INDEX.md'))) return { total: 0, anchored: 0, files: 0, linked: 0 }
+  const hits = parseDecisionEntries(kdir)
+  let anchored = 0
+  let files = 0
+  let linked = 0
+  for (const h of hits) {
+    const hasAnchor = Boolean(h.anchor && h.anchor.trim() && h.anchor.trim() !== '未记录')
+    const hasFiles = Array.isArray(h.files) && h.files.length > 0
+    if (hasAnchor) anchored++
+    if (hasFiles) files++
+    if (hasAnchor || hasFiles) linked++
+  }
+  return { total: hits.length, anchored, files, linked }
+}
diff --git a/eval/knowledge/lib/faces.mjs b/eval/knowledge/lib/faces.mjs
new file mode 100644
index 00000000..f68830ce
--- /dev/null
+++ b/eval/knowledge/lib/faces.mjs
@@ -0,0 +1,56 @@
+/**
+ * eval/knowledge/lib/faces.mjs — 分面执行（raw/rendered 双口径 + 截断归因）
+ *
+ * raw = 引擎全量命中序；rendered = 各消费面实际切片（flow 📚 行 top-3、rejected top-5、
+ * search limit 10、scope entry 3 + decision 20）。raw 命中而 rendered 不中 → truncated，
+ * 用于区分「引擎未召回」与「召回了但被截断/渲染丢弃」。
+ */
+import { runEntries, runDecisions, searchView, runScope } from './engine.mjs'
+import { hitMatches } from './probes.mjs'
+import { summarize } from './metrics.mjs'
+
+export const FACES = ['entries', 'decisions', 'search', 'scope']
+
+/** 期望谓词排名（file 级前缀语义；1-based，未命中 = Infinity）。 */
+export function rankWithMatches(hits, expected) {
+  let best = Infinity
+  hits.forEach((h, i) => {
+    if (expected.some((e) => hitMatches(h, e))) best = Math.min(best, i + 1)
+  })
+  return best
+}
+
+/** 单仓单面：raw/rendered 双口径 + 截断清单。 */
+export function runFace(repoPath, face, cases) {
+  const ranksRaw = []
+  const ranksRendered = []
+  const truncated = []
+  for (const c of cases) {
+    let rawHits = []
+    let renderedHits = []
+    if (face === 'entries') {
+      const r = runEntries(repoPath, c.query)
+      rawHits = r.hits
+      renderedHits = r.hits.slice(0, 3)
+    } else if (face === 'decisions') {
+      const r = runDecisions(repoPath, c.query)
+      rawHits = r.hits
+      renderedHits = r.hits.slice(0, 5)
+    } else if (face === 'search') {
+      rawHits = searchView(repoPath, c.query, 10).map((r) => r.file)
+      renderedHits = rawHits.slice(0, 10)
+    } else if (face === 'scope') {
+      const r = runScope(repoPath, c.scope_files || [])
+      rawHits = r.merged
+      renderedHits = [...r.entryHits.slice(0, 3), ...r.decisionHits.slice(0, 20)]
+    }
+    // search 面单位是 file：expected 的 anchor 后缀投影掉
+    const expected = face === 'search' ? c.expected.map((e) => String(e).split('#')[0]) : c.expected
+    const rr = rankWithMatches(rawHits, expected)
+    const rn = rankWithMatches(renderedHits, expected)
+    ranksRaw.push(rr)
+    ranksRendered.push(rn)
+    if (Number.isFinite(rr) && !Number.isFinite(rn)) truncated.push(c.id)
+  }
+  return { raw: summarize(ranksRaw), rendered: summarize(ranksRendered), truncated }
+}
diff --git a/eval/knowledge/lib/metrics.mjs b/eval/knowledge/lib/metrics.mjs
new file mode 100644
index 00000000..dfdbdd45
--- /dev/null
+++ b/eval/knowledge/lib/metrics.mjs
@@ -0,0 +1,56 @@
+/**
+ * eval/knowledge/lib/metrics.mjs — 检索评测指标纯函数（零 IO 零全局状态，可单测）
+ *
+ * 候选与期望的统一单位是「命中键」字符串（file#anchor / D-id / FR-id / 文件路径），
+ * 由 engine 层归一成本模块的输入；本模块只做排名数学。
+ * 浮点输出统一 4 位小数、键序固定——baseline.json 可 diff 的前提。
+ */
+
+/** 期望条目在有序命中列表中的最佳名次（1-based；未命中 = Infinity）。 */
+export function rankOf(hits, expectedKeys) {
+  const want = new Set(expectedKeys || [])
+  let best = Infinity
+  for (let i = 0; i < hits.length; i++) {
+    if (want.has(hits[i])) best = Math.min(best, i + 1)
+  }
+  return best
+}
+
+/** Top-k 命中判定（rank 为 Infinity 视为未命中）。 */
+export function hitAtK(rank, k) {
+  return Number.isFinite(rank) && rank <= k
+}
+
+/** 平均倒数排名（未命中记 0）。 */
+export function mrr(ranks) {
+  if (ranks.length === 0) return 0
+  return ranks.reduce((s, r) => s + (Number.isFinite(r) ? 1 / r : 0), 0) / ranks.length
+}
+
+/** precision@k：前 k 个命中里属于期望集的占比（top 为空记 0）。 */
+export function precisionAtK(hits, expectedKeys, k) {
+  const want = new Set(expectedKeys || [])
+  const top = hits.slice(0, k)
+  if (top.length === 0) return 0
+  return top.filter((h) => want.has(h)).length / top.length
+}
+
+/** 汇总一组 case 的分面指标（键序固定 top1/top3/mrr/n；空集全零）。 */
+export function summarize(ranks) {
+  const n = ranks.length
+  const r4 = (x) => Math.round(x * 10000) / 10000
+  return {
+    top1: n > 0 ? r4(ranks.filter((r) => hitAtK(r, 1)).length / n) : 0,
+    top3: n > 0 ? r4(ranks.filter((r) => hitAtK(r, 3)).length / n) : 0,
+    mrr: r4(mrr(ranks)),
+    n,
+  }
+}
+
+/** 稳定排序：按 score 降序，同分保持原始序（评测输出确定性的前提）。 */
+export function stableSortByScore(items, scoreOf) {
+  return items
+    .map((it, i) => ({ it, i, s: scoreOf(it) }))
+    .sort((a, b) => (b.s - a.s) || (a.i - b.i))
+    .map((x) => x.it)
+}
diff --git a/eval/knowledge/lib/probes.mjs b/eval/knowledge/lib/probes.mjs
new file mode 100644
index 00000000..2d5e09c4
--- /dev/null
+++ b/eval/knowledge/lib/probes.mjs
@@ -0,0 +1,92 @@
+/**
+ * eval/knowledge/lib/probes.mjs — 六类缺陷探针执行器
+ *
+ * fixture 物化到 mkdtemp 仓根（<root>/.sillyspec/knowledge/...）后跑真实引擎函数，
+ * 断言按 evaluateCase 语义评估。pass = 修复后期望；缺陷存在时 pass=false（检出缺陷）。
+ * 临时目录 finally 清理；不写仓、不触网络/遥测。
+ */
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, dirname } from 'node:path'
+import { PROBE_FIXTURES } from '../fixtures/index.mjs'
+import { runEntries, runDecisions, searchView, runScope, catalogHealth } from './engine.mjs'
+
+/** expected 匹配：含 "#" 精确；否则文件级前缀（hit === exp 或 hit.startsWith(exp + "#")）。 */
+export function hitMatches(hit, expected) {
+  if (String(expected).includes('#')) return hit === expected
+  return hit === expected || String(hit).startsWith(`${expected}#`)
+}
+
+function containsAll(hits, expected) {
+  return (expected || []).every((e) => hits.some((h) => hitMatches(h, e)))
+}
+
+function excludesAll(hits, expected) {
+  return (expected || []).every((e) => !hits.some((h) => hitMatches(h, e)))
+}
+
+/** 物化 fixture 到 mkdtemp 仓根；返回仓根（调用方负责清理）。 */
+export function materialize(fixture) {
+  const root = mkdtempSync(join(tmpdir(), `ek-probe-${fixture.defect}-`))
+  const kdir = join(root, '.sillyspec', 'knowledge')
+  for (const [rel, content] of Object.entries(fixture.files || {})) {
+    const p = join(kdir, rel)
+    mkdirSync(dirname(p), { recursive: true })
+    writeFileSync(p, content)
+  }
+  return root
+}
+
+/** 单 case 评估 → { name, pass, detail }。 */
+export function evaluateCase(repoRoot, c) {
+  const expect = c.expect || {}
+  const fails = []
+  let hits = []
+  if (c.kind === 'entries' || c.kind === 'search' || c.kind === 'decisions' || c.kind === 'scope') {
+    if (c.kind === 'entries') hits = runEntries(repoRoot, c.query).hits
+    else if (c.kind === 'decisions') hits = runDecisions(repoRoot, c.query).hits
+    else if (c.kind === 'scope') hits = runScope(repoRoot, c.scope_files || []).merged
+    else {
+      const rows = searchView(repoRoot, c.query)
+      hits = rows.map((r) => r.file)
+      if (expect.score_contract) {
+        const bad = rows.filter((r) => r.score !== r.matchedTags.length)
+        if (bad.length > 0) fails.push(`score 契约违反：${bad.map((r) => `${r.file} score=${r.score} 命中=${r.matchedTags.length}`).join('；')}`)
+      }
+    }
+    if (!containsAll(hits, expect.contains)) fails.push(`缺少期望命中：${(expect.contains || []).filter((e) => !hits.some((h) => hitMatches(h, e))).join('、')}`)
+    if (!excludesAll(hits, expect.excludes)) fails.push(`出现禁止命中：${(expect.excludes || []).filter((e) => hits.some((h) => hitMatches(h, e))).join('、')}`)
+    if (expect.empty === true && hits.length > 0) fails.push(`期望空命中但得到 ${hits.length} 条`)
+    if (expect.empty === false && hits.length === 0) fails.push('期望非空但零命中')
+  } else if (c.kind === 'catalog') {
+    const health = catalogHealth(repoRoot)
+    hits = [`total=${health.total}`, `anchored=${health.anchored}`, `files=${health.files}`, `linked=${health.linked}`]
+    for (const [k, v] of Object.entries(expect.health || {})) {
+      if (health[k] !== v) fails.push(`catalog.${k}=${health[k]} ≠ 期望 ${v}`)
+    }
+  } else {
+    fails.push(`未知 kind：${c.kind}`)
+  }
+  return {
+    name: c.name || c.kind,
+    pass: fails.length === 0,
+    detail: fails.length === 0 ? `ok（hits=${hits.length}）` : fails.join('；'),
+    hits: hits.slice(0, 8),
+  }
+}
+
+/** 全量探针（六个 fixture 顺序执行；tmp 目录 finally 清理）。 */
+export function runAllProbes() {
+  const out = []
+  for (const fixture of PROBE_FIXTURES) {
+    let root = ''
+    try {
+      root = materialize(fixture)
+      const cases = fixture.cases.map((c) => evaluateCase(root, c))
+      out.push({ defect: fixture.defect, pass: cases.every((c) => c.pass), cases })
+    } finally {
+      if (root) rmSync(root, { recursive: true, force: true })
+    }
+  }
+  return out
+}
