+      if (parseChangeNamesFromSubject(subject).includes(change)) own.push(subject.slice(0, 80))
+    }
+    return { drifted: own.length > 0, ownCommits: own, head }
+  } catch { return { drifted: false, ownCommits: [], head: null } }
