 export function deriveChangeTitle(input, max = 50) {
   for (const l of String(input || '').replace(/\r\n/g, '\n').split('\n')) {
     const t = l.trim()
     if (!t) continue
     if (/^成功标准\s*[:：]/.test(t)) break
