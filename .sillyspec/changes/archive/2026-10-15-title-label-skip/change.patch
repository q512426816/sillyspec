+    const stripped = t.replace(/^(?:需求|动机|背景|任务|标题|动机与背景|背景与动机)\s*[:：]\s*/, '').trim()
     if (!stripped) continue
     const one = stripped.replace(/\s+/g, ' ')
     return one.length > max ? one.slice(0, max) + '…' : one
