+
+console.log('\n--- ③ plan.md 无显式 Wave 段 → warn 放行（隐式 Wave/light 不误伤）---')
+{
+  // 光计划形态：plan.md 无任何「## Wave N」段头（隐式合成单 Wave 语义），tasks 未勾也不拦
+  const fx = makeFixture({
+    tasksMd: [
+      '- [x] task-01: 门测试任务一',
