+  assert(r.stdout.includes('完成度门通过'), 'autoCheck 补勾后：输出含「完成度门通过」')
+}
+
+console.log('\n--- ⑤ 非「Wave N 执行」步骤名 → 零行为 ---')
+{
+  const fx = makeFixture({
