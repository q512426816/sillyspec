+
+console.log('\n--- ④ autoCheck 先行幂等（pass review + 未勾 checkbox → 跑后被勾、门放行）---')
+{
+  const fx = makeFixture({
+    withReview: true,
+    tasksMd: [
+      '- [x] task-01: 门测试任务一',
+      '- [ ] task-02: 门测试任务二',
