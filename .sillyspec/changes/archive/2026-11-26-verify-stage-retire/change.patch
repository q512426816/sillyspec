-  for (let i = 0; i < lines.length; i++) {
-    for (const re of lineRes) {
-      for (const m of lines[i].matchAll(re)) record(m[1], i + 1)
-    }
-  }
-
-  // ── 请求调用：调用行起 8 行窗口 DTO 键（窗口口径对齐 extractPayloadKeys）+ 首参 URL 捕获 ──
-  const urlsByCall = []
