+  if (Array.isArray(fmObj.acceptance)) return { status: 'ok', acceptance: fmObj.acceptance.filter(x => typeof x === 'string' && x.trim() !== '').map(x => x.trim()), error: null }
+  return { status: 'ok', acceptance: [], error: null }
