-/** 驼峰切词（doSubmit → [do, Submit]；submitOrder → [submit, Order]；snake/连字符一并切段） */
-const probe9SplitHumps = (s) => String(s || '').replace(/([a-z0-9])([A-Z])/g, '$1 $2').split(/[^A-Za-z0-9]+/).filter(Boolean)
