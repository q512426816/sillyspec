+      ).run(now, stageRow.id);
+      result.steps = upd.changes;
+      sqlDb.prepare('UPDATE changes SET current_stage = ?, last_active = ? WHERE id = ?').run('archive', now, changeRow.id);
+      result.applied = true;
+    });
+    if (result.applied) {
