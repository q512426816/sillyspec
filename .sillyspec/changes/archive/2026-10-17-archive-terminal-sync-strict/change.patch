+
+test('终态 + 无 treeOk（未确认）→ 🚨 告警 + 自救命令 + exitCode=1', async () => {
+  process.env.SILLYHUB_PLATFORM_URL = 'http://127.0.0.1:9'
+  process.env.SILLYHUB_PLATFORM_TOKEN = 't'
+  const r = await triggerSyncTerminalStrict(cwd, 'c1', {}, {
