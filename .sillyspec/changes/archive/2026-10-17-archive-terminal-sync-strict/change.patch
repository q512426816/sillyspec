+  let dbStatus = opts.changeStatus ?? null
+  if (dbStatus === null) {
+    try {
+      const { resolvePlatformSpecDir, ProgressManager } = await import('../progress.js')
+      const specDir = resolvePlatformSpecDir(cwd)
+      if (specDir && existsSync(join(specDir, '.runtime', 'sillyspec.db'))) {
