+  process.env.SILLYHUB_PLATFORM_TOKEN = 't'
+  const r = await triggerSyncTerminalStrict(cwd, 'c1', {}, {
+    changeStatus: 'archived',
+    syncImpl: async () => ({ synced: 1, treeOk: true }),
