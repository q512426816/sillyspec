+  assert.equal((cand[1].match(/`backend\/test\/existing-/g) || []).length, 0, '次卡不再重复路径')
+})
+
+test('2026-11-13 FR-02：候选集不同的卡不互相折叠', () => {
+  const p7 = {
+    applicable: true,
+    tasks: [
+      { task: 'task-03', acceptance: ['A'], testFiles: [], existingTests: EXISTING(6), hints: [null] },
