+      const everyHasPredicate = segs.length > 1 && segs.every((s) => SEGMENT_PREDICATE_RE.test(s))
+      if (everyHasPredicate) out.push(...segs)
+      else out.push(part)
     } else out.push(part)
   }
   return out
