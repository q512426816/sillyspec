 function splitCompoundCriteria(item) {
   const parts = String(item).split(/[；;]/).map((s) => s.trim()).filter(Boolean)
   const out = []
   for (const part of parts) {
     const pathLike = /\.[A-Za-z]{1,5}\b/.test(part) || (part.match(/\//g) || []).length > 1
     if (!pathLike && /[／/]/.test(part)) {
