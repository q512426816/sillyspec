+  const text = String(designMd || '').replace(/\r\n/g, '\n')
+  if (!text) return ''
+  const out = []
+  let collecting = false
+  for (const line of text.split('\n')) {
+    const h = line.match(/^#{1,3}\s+(.*)$/)
+    if (h) {
+      collecting = /权限|角色/.test(h[1])
+      if (collecting) out.push(h[1])
+      continue
+    }
+    if (collecting) out.push(line)
+  }
+  return out.join('\n')
