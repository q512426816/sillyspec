+
+  const r5 = evaluatePassEligibility(base({
+    ...CLEAN(), smokeRan: 'not-ran',
+    handover: { count: 1, items: [{ type: 'env-blocked', item: '冒烟环境阻断', condition: '恢复后复跑', severity: 'advisory' }] },
