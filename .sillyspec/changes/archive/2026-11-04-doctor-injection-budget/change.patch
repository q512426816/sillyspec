+const INJECTION_BUDGET_BYTES = 20000;
+
+/**
+ * 常驻注入面体积预算（WARN 只读）：逐文件 statSync 扫描仓根 AGENTS.md / CLAUDE.md /
+ * SKILL.md、templates/agents-instruction.md（模板源，本仓开发面）与 .claude/skills 下
+ * 各技能的 SKILL.md。
+ * 预算内回显最大面（体积可观测）；无任何注入面（非 init 仓）跳过不误报。
+ */
+export function detectInjectionBudget(cwd) {
+  const dim = { name: 'injection_budget', label: '常驻注入面体积预算（压缩生存）', safe_actions: [] };
+  const oversized = [];
+  let scanned = 0;
+  let maxSeen = null;
+  const consider = (abs, rel) => {
+    try {
+      const size = statSync(abs).size;
+      scanned += 1;
+      if (!maxSeen || size > maxSeen.size) maxSeen = { rel, size };
+      if (size > INJECTION_BUDGET_BYTES) oversized.push(`${rel}（${(size / 1024).toFixed(1)}KB）`);
+    } catch { /* 单文件 stat 失败跳过（fail-soft 同 detectDocBloat 口径） */ }
+  };
+  for (const f of ['AGENTS.md', 'CLAUDE.md', 'SKILL.md', join('templates', 'agents-instruction.md')]) {
+    const abs = join(cwd, f);
+    if (existsSync(abs)) consider(abs, f.split('\\').join('/'));
+  }
+  try {
+    const skillsDir = join(cwd, '.claude', 'skills');
+    if (existsSync(skillsDir)) {
+      for (const e of readdirSync(skillsDir, { withFileTypes: true })) {
+        if (!e.isDirectory()) continue;
+        const skillMd = join(skillsDir, e.name, 'SKILL.md');
+        if (existsSync(skillMd)) consider(skillMd, `.claude/skills/${e.name}/SKILL.md`);
+      }
+    }
+  } catch { /* skills 目录不可读跳过 */ }
+  if (scanned === 0) {
+    return { ...dim, pass: true, severity: null, findings: ['无 AGENTS/CLAUDE/SKILL.md 注入面（非 init 仓或未安装，跳过）'] };
+  }
+  if (oversized.length > 0) {
+    dim.safe_actions.push({ action: '按 superpowers references/ 拆分模式瘦身：SKILL.md 只留全程骨架，步骤局部内容拆 references/ 到步现读（压缩后截断线内自洽）', risk: 'low' });
+  }
+  dim.findings = oversized.length > 0
+    ? [`超 ${INJECTION_BUDGET_BYTES} 字节压缩截断线（超线内容压缩后对 agent 不可见，纪律静默丢失）：${oversized.join('、')}`]
+    : [`常驻注入面在预算内（扫描 ${scanned} 个面，最大 ${maxSeen.rel} ${(maxSeen.size / 1024).toFixed(1)}KB / 预算 20KB）`];
+  return oversized.length === 0
+    ? { ...dim, pass: true, severity: CHECK_SEVERITY.PASSED }
+    : { ...dim, pass: false, severity: CHECK_SEVERITY.WARNING };
+}
