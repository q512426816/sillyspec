+    commitFile(work, 'f1.txt', 'f1\n', `feat: f1 (${APP})`)
+    git(work, ['checkout', '-q', branch])
+    git(work, ['merge', '--no-ff', '-m', `merge feat (${APP})`, 'feat'])
