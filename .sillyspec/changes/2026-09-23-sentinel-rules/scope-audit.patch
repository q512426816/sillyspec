+    // git 失败（impl 返回 null）→ commits/dirtyCode null（fail-open 可区分）
+    const fail = buildSnapshot({ changeDir, cwd: root, runtimeRoot, changeName: 'c1', gitHeadImpl: () => null, gitLogImpl: () => null, porcelainImpl: () => null })
