+  const warns = [], logs = []
+  const ow = console.warn, ol = console.log
+  console.warn = (m) => warns.push(String(m))
+  console.log = (m) => logs.push(String(m))
+  return { warns, logs, restore() { console.warn = ow; console.log = ol } }
+}
