+  }
+
+  // ─────────────────────────────────────────
+  console.log('\n[C] ③类脚手架聚合（reconcile-undeclared-scaffold-flood）')
+  {
+    const proj = join(tmpRoot, 'proj5')
+    initRepo(proj)
