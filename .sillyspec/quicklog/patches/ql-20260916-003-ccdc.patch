+      cur = {}
+      items.push(cur)
+      cur[item[1]] = clean(item[2])
+      continue
+    }
+    const kv = l.match(/^\s*([A-Za-z_][\w-]*):\s*(.*)$/)
+    if (kv && cur) cur[kv[1]] = clean(kv[2])
+  }
