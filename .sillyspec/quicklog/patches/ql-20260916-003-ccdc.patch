+  const headIdx = lines.findIndex(l => /^verify_precedents:\s*(?:#.*)?$/.test(l))
+  if (headIdx < 0) return []
+  const items = []
+  let cur = null
+  const clean = (v) => String(v || '').replace(/\s+#.*$/, '').trim()
+  for (let i = headIdx + 1; i < lines.length; i++) {
