+    if (/^\S/.test(l)) break // 下一个顶层键 → 块结束
+    if (!l.trim() || /^\s*#/.test(l)) continue
+    const item = l.match(/^\s*-\s+([A-Za-z_][\w-]*):\s*(.*)$/)
