+    assert.deepEqual(miss.commits.map((c) => c.hash), ['aaa1111'])
+    const empty = buildSnapshot({ ...base, gitLogImpl: () => 'aaa1111|chore: 无关提交\n', gitLogWorktreeImpl: () => '', porcelainImpl: () => '' })
