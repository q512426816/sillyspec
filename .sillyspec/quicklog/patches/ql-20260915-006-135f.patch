+goal: >
+  x
+implementation: 修改
+acceptance: ok
+verify: npm run test
+---
+正文
+`, 'utf8')
+  const mixed = validateTaskCommands(changeDir, mainRoot, null, registry)
+  assert(mixed.ok === true, '主仓卡（无 repo:）仍按主仓根核验（npm run test 命中主仓 scripts）')
+}
