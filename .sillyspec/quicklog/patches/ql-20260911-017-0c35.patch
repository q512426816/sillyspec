+  write(join(rt, 'friction-tally-2026-08-01-login.json'), { events: {}, history: [] })
+
+  pruneArchivedChangeRuntime(rt, 'login')
+  assert(!existsSync(join(rt, 'friction-tally-login.json')), '短名 friction-tally 已删')
