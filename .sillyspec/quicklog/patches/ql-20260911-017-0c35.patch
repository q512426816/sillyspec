++// 1. 路由落点红线（D-002/R-04）
++// ─────────────────────────────────────────
++console.log('\n--- 1. 路由落点：.runtime 树内、永不落 changes/ ---')
++{
++  const cwd = makeCwd()
++  const change = '2026-09-11-routing-check'
