+const PINNED_CACHE_ENV_VARS = [
+  { env: 'UV_CACHE_DIR', tool: 'uv' },
+  { env: 'PIP_CACHE_DIR', tool: 'pip' },
+  { env: 'POETRY_CACHE_DIR', tool: 'poetry' },
+]
